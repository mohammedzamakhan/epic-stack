{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "epic-startup-cms",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": [
    // Enable Node.js API
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "D1",
      // Replace DATABASE_ID with the actual D1 database ID after running:
      //   wrangler d1 create epic-startup-cms
      "database_id": "DATABASE_ID",
      "database_name": "epic-startup-cms",
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      // Create the R2 bucket with:
      //   wrangler r2 bucket create epic-startup-cms-media
      "bucket_name": "epic-startup-cms-media",
    },
  ],
  // Secrets (set via `wrangler secret put <NAME>`):
  //   PAYLOAD_SECRET
  //   CRON_SECRET
  //   PREVIEW_SECRET
  "vars": {
    "CMS_USE_R2": "true",
    "NEXT_PUBLIC_SERVER_URL": "https://epic-startup-cms.zama-887.workers.dev",
    "WEB_APP_URL": "https://epic-startup.zama-887.workers.dev",
  },
}
