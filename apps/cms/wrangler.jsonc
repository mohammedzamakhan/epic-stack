{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "epic-startup-cms",
  "account_id": "8870705ba38bb749459b00ab2949f857",
  "compatibility_date": "2025-08-15",
  "workers_dev": true,
  "compatibility_flags": [
    // Enable Node.js API
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "3091bea4-f213-44ab-9779-8779059bd564",
      "database_name": "epic-startup-cms",
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "epic-startup-cms-media",
    },
  ],
  // Secrets (set via `wrangler secret put <NAME>`):
  //   PAYLOAD_SECRET
  //   CRON_SECRET
  //   PREVIEW_SECRET
  "vars": {
    "NEXT_PUBLIC_SERVER_URL": "https://epic-startup-cms.zama-887.workers.dev",
    "WEB_APP_URL": "https://epic-startup.zama-887.workers.dev",
    "NEXT_PUBLIC_WEB_APP_URL": "https://epic-startup.zama-887.workers.dev",
  },
}
