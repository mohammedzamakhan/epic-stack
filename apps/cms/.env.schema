# Epic Stack - CMS (Payload CMS)
# Local + Vercel use SQLite (file or Turso). Cloudflare Workers can use D1.
# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# @defaultRequired=infer @defaultSensitive=false
# @generateTypes(lang=ts, path=env.d.ts)
# ----------

# SQLite database URL
# Local: file:./data/cms.db
# Vercel (Hobby): Turso libsql URL (libsql://…turso.io)
# Cloudflare Workers: unused when the D1 binding is present
# @required @sensitive=false
DATABASE_URL=file:./data/cms.db

# Turso auth token. Required when DATABASE_URL is a remote libsql URL.
# @sensitive
DATABASE_AUTH_TOKEN=

# Used to encrypt JWT tokens for Payload CMS authentication
# @required @sensitive
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
# On Vercel this can be omitted; the deployment URL is used instead
# @type=url @sensitive=false
NEXT_PUBLIC_SERVER_URL=http://localhost:3006

# Secret used to authenticate cron jobs
# @required @sensitive
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
# @required @sensitive
PREVIEW_SECRET=YOUR_SECRET_HERE

# Marketing web origin for live-preview links (generatePreviewPath).
# @type=url @sensitive=false
WEB_APP_URL=https://epic-startup.me:2999

# Bearer token for the local `/api/seed` route. Ignored in production.
# @sensitive
CMS_SEED_SECRET=

# Cloudflare R2 — S3-compatible credentials for Vercel (and any Node host).
# On Cloudflare Workers the R2_BUCKET binding is used instead of these keys.
# @sensitive
R2_ACCESS_KEY_ID=

# @sensitive
R2_SECRET_ACCESS_KEY=

# @sensitive=false
R2_BUCKET_NAME=epic-startup-cms-media

# Cloudflare Account ID (required for the R2 S3 endpoint on Vercel)
# @sensitive
CLOUDFLARE_ACCOUNT_ID=

# Set true on Cloudflare Workers so media skips the ephemeral filesystem
# @sensitive=false
CMS_USE_R2=
