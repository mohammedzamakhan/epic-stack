{
  "name": "cms",
  "version": "1.0.0",
  "description": "Website template for Payload CMS on Cloudflare Workers",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "build:worker": "opennextjs-cloudflare build",
    "deploy": "npm run deploy:database && npm run deploy:app",
    "deploy:app": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:database": "cross-env NODE_ENV=production PAYLOAD_SECRET=ignore payload migrate && wrangler d1 execute D1 --command 'PRAGMA optimize' --remote",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --webpack -p 3006",
    "devsafe": "rm -rf .next && rm -rf .open-next && cross-env NODE_OPTIONS=--no-deprecation next dev --webpack -p 3006",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:types:cloudflare": "wrangler types --env-interface CloudflareEnv",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation npm --ignore-workspace install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm npm-lock.yaml && npm --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test:disable": "npm run test:int",
    "test:e2e:disable": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" npm exec playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.6.2",
    "@payloadcms/admin-bar": "3.87.0",
    "@payloadcms/db-sqlite": "3.87.0",
    "@payloadcms/live-preview-react": "3.87.0",
    "@payloadcms/next": "3.87.0",
    "@payloadcms/plugin-form-builder": "3.87.0",
    "@payloadcms/plugin-nested-docs": "3.87.0",
    "@payloadcms/plugin-redirects": "3.87.0",
    "@payloadcms/plugin-search": "3.87.0",
    "@payloadcms/plugin-seo": "3.87.0",
    "@payloadcms/richtext-lexical": "3.87.0",
    "@payloadcms/storage-r2": "3.87.0",
    "@payloadcms/ui": "3.87.0",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@react-email/preview-server": "^5.0.7",
    "@sentry/react-router": "10.29.0",
    "ai": "5.0.108",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "geist": "^1.3.0",
    "graphql": "^16.8.2",
    "lucide-react": "^0.534.0",
    "next": "^16.2.12",
    "next-sitemap": "^4.2.3",
    "payload": "3.87.0",
    "prism-react-renderer": "^2.3.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "7.45.4",
    "react-router": "^8.3.0",
    "react-syntax-highlighter": "16.1.0",
    "storybook": "^10.5.6",
    "tailwind-merge": "^3.2.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "1.57.0",
    "@tailwindcss/typography": "^0.5.13",
    "@testing-library/react": "16.3.0",
    "@types/escape-html": "^1.0.2",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.19.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "^10.4.19",
    "close-with-grace": "^2.3.0",
    "copyfiles": "^2.4.1",
    "eslint": "^9.26.0",
    "eslint-config-next": "15.4.4",
    "jsdom": "^27.1.0",
    "mime-types": "^3.0.1",
    "msw": "^2.11.4",
    "playwright": "1.57.0",
    "playwright-core": "1.54.1",
    "postcss": "^8.5.25",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.8.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.22.0"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  }
}
