# Regional Tenant Node Environment Variables
#
# @defaultRequired=infer @defaultSensitive=false
# ----------

# @required @sensitive=false
PORT=3007

# JWT for customer access tokens. Verified only on tenant-api (browser holds the token).
# @required @sensitive
JWT_SECRET=dev-jwt-secret-do-not-use-in-prod-32b

# HMAC key for OTP and refresh token hashes. Distinct from INTERNAL_COMMAND_TOKEN.
# @required @sensitive
AUTH_HMAC_SECRET=dev-auth-hmac-secret-do-not-use-in-prod

# Internal token for provisioning. Must match App INTERNAL_COMMAND_TOKEN.
# @required @sensitive
INTERNAL_COMMAND_TOKEN=dev-internal-command-token-do-not-use-in-prod

# Central Prisma URL for org metadata (not customer PII)
# @required @sensitive=false
DATABASE_URL="file:../../packages/database/db/data.db?connection_limit=1"

# This node serves only orgs whose dataRegion matches this value.
# Use "us" for the default local process. Run a second process with DATA_REGION=ksa PORT=3009 to test KSA.
# Not a secret — the value "us" would otherwise match every JSON "status" field.
# @required @sensitive=false @type=enum(us, ksa)
DATA_REGION=us

# Root domain used to map browser Origin (acme.epic-startup.me) to an org slug.
# @sensitive=false
ROOT_APP=epic-startup.me
