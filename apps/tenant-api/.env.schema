# Regional Tenant Node Environment Variables
#
# @defaultRequired=infer @defaultSensitive=false
# ----------

# @required @sensitive=false
PORT=3007

# JWT for customer access tokens. Verified only on tenant-api (browser holds the token).
# @required @sensitive
JWT_SECRET=dev-jwt-secret-do-not-use-in-prod-32b

# HMAC key for OTP and refresh token hashes. Distinct from INTERNAL_COMMAND_TOKEN.
# @required @sensitive
AUTH_HMAC_SECRET=dev-auth-hmac-secret-do-not-use-in-prod

# Internal token for provisioning. Must match App INTERNAL_COMMAND_TOKEN.
# @required @sensitive
INTERNAL_COMMAND_TOKEN=dev-internal-command-token-do-not-use-in-prod

# Secret used to sign/verify short-lived operator JWTs (audience:
# "tenant-api-operator"). MUST differ from INTERNAL_COMMAND_TOKEN so the
# browser-issued operator token cannot authenticate cron/provision routes.
# @required @sensitive
TENANT_OPERATOR_TOKEN=dev-operator-token-do-not-use-in-prod-32b

# Control-plane SQLite URL for org metadata (not customer PII).
# Production KSA should use APP_URL so this node can resolve published orgs
# from App instead of a local control-plane replica.
# @required @sensitive=false
DATABASE_URL="file:../../packages/database/db/data.db?connection_limit=1"

# US App origin. Used when the control-plane database has no Organization rows (KSA OCI VM).
# @sensitive=false
APP_URL=http://localhost:3001

# Directory for per-org SQLite files (tenant_{orgId}.db). Unset locally.
# Production OCI mounts a block volume here (/data/tenants).
# @sensitive=false
TENANT_DB_DIR=

# This node serves only orgs whose dataRegion matches this value.
# Use "us" for the default local process. Run a second process with DATA_REGION=ksa PORT=3009 to test KSA.
# Not a secret — the value "us" would otherwise match every JSON "status" field.
# @required @sensitive=false @type=enum(us, ksa)
DATA_REGION=us

# Root domain used to map browser Origin (acme.epic-startup.com) to an org slug.
# @sensitive=false
ROOT_APP=epic-startup.test

# Twilio — US node only. Do not set on the KSA VM (@repo/sms).
# @sensitive=false
TWILIO_ACCOUNT_SID=

# @sensitive
TWILIO_AUTH_TOKEN=

# @sensitive=false
TWILIO_FROM_NUMBER=

# Hourly SMS send cap across all IPs/phones. Defaults to 500 in code.
# @type=number @sensitive=false
GLOBAL_SMS_CAP=500

# Oracle Cloud Email Delivery (tenant customer/operator marketing email).
# When unset, tenant-api logs [OCI EMAIL MOCK] in non-production.
# @sensitive
OCI_TENANCY_OCID=

# @sensitive
OCI_USER_OCID=

# @sensitive=false
OCI_FINGERPRINT=

# PEM private key for the API user. Use \n for newlines in .env files.
# @sensitive
OCI_PRIVATE_KEY=

# OCI region for Email Delivery + Monitoring, e.g. me-jeddah-1 or us-ashburn-1
# @sensitive=false
OCI_REGION=

# Compartment that owns the approved sender
# @sensitive
OCI_EMAIL_COMPARTMENT_ID=

# Approved sender email address configured in OCI Email Delivery
# @sensitive=false
OCI_EMAIL_SENDER_EMAIL=

# @sensitive=false
OCI_EMAIL_SENDER_NAME=Epic Startup

# Approved sender OCID (resourceId) for oci_emaildelivery metrics filters
# @sensitive
OCI_EMAIL_SENDER_OCID=

# OCI Logging log OCID for the email domain OutboundRelayed log (open/click events).
# Enable logging on the email domain in OCI Console, then paste the log OCID here.
# @sensitive
OCI_EMAIL_LOG_OCID=
