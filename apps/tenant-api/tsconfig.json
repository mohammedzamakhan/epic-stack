{
	"extends": ["@epic-web/config/typescript"],
	"include": ["src/**/*", "workers/**/*", "env.d.ts"],
	"exclude": [
		"src/**/*.test.ts",
		"src/**/*integration.test.ts",
		"src/**/*adversarial.test.ts"
	],
	"compilerOptions": {
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"types": ["@cloudflare/workers-types"]
	}
}
