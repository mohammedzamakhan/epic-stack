# Copy to .env on the OCI VM. Do not commit real values.
# US (Ashburn): DATA_REGION=us
# KSA (Riyadh): DATA_REGION=ksa

DATA_REGION=us
PORT=8080
TENANT_DB_DIR=/data/tenants
NODE_ENV=production

JWT_SECRET=
AUTH_HMAC_SECRET=
INTERNAL_COMMAND_TOKEN=

# US App origin so this node can resolve org flags without the Prisma volume.
APP_URL=https://epic-startup.me
ROOT_APP=epic-startup.me

# Optional. Only needed if this node reads Prisma locally (US). KSA should use APP_URL.
# DATABASE_URL=file:/data/tenants/unused.db

# US only. Do not set Twilio on the KSA VM.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Image tag written by CI / docker compose pull.
# TENANT_API_IMAGE=ghcr.io/<owner>/epic-startup/tenant-api:<sha>
