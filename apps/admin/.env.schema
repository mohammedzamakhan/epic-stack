# Epic Stack - Admin Dashboard
# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# NOTE: Admin does not use integration OAuth, GitHub login, or Stripe.
# Email: platform marketing uses `sendEmail()` — set EMAIL_PROVIDER + OCI_* or
# RESEND_API_KEY to match App. Shares SESSION_SECRET, SSO_ENCRYPTION_KEY,
# AUDIT_LOG_SECRET_KEY, and INTERNAL_COMMAND_TOKEN with the App.
#
# @currentEnv=$NODE_ENV
# @defaultRequired=infer @defaultSensitive=false
# @generateTypes(lang=ts, path=env.d.ts)
# ----------

# @type=enum(production, development, test)
NODE_ENV=development


# @required
DATABASE_PATH="../../packages/database/db/data.db"

# @required @type=url
DATABASE_URL="file:./db/data.db?connection_limit=1"

CACHE_DATABASE_PATH="./../app/other/cache.db"

# @required @sensitive
SESSION_SECRET="super-duper-s3cret"

# @required @sensitive
HONEYPOT_SECRET="super-duper-s3cret"

# Shared with App and every tenant-api for cache/provision commands.
# @required @sensitive
INTERNAL_COMMAND_TOKEN=dev-internal-command-token-do-not-use-in-prod

# @sensitive=false
SENTRY_DSN=your-dsn

# Public origin (`https://admin.{apex}`). Cookie Domain is inferred from this.
# @required @type=url @sensitive=false
BASE_URL=http://localhost:3004

# @type=enum(CLOSED_BETA, PUBLIC_BETA, LAUNCHED) @sensitive=false
LAUNCH_STATUS=LAUNCHED

# @type=boolean @sensitive=false
ALLOW_INDEXING=true

# Org S3 / SSO decrypt. Must match apps/app when admin reads encrypted org config.
# @sensitive
SSO_ENCRYPTION_KEY=

# HMAC for audit log integrity. Required in production (@repo/audit).
# @sensitive
AUDIT_LOG_SECRET_KEY=

# Tigris Object Storage (S3-compatible) Configuration
# Access key ID is an identifier (also appears in SigV4 presigned URLs); not secret.
# @required @sensitive=false
AWS_ACCESS_KEY_ID=mock-access-key

# @required @sensitive
AWS_SECRET_ACCESS_KEY=mock-secret-key

# @required @sensitive=false
AWS_REGION=auto

# @required @type=url @sensitive=false
AWS_ENDPOINT_URL_S3=https://<account-id>.r2.cloudflarestorage.com

# @required @sensitive=false
BUCKET_NAME=mock-bucket

# BetterStack Uptime Monitoring Configuration
# @sensitive
BETTERSTACK_API_KEY=

# @type=url @sensitive=false
BETTERSTACK_URL=

# Build-time only (Sentry source map upload)
# @sensitive
SENTRY_AUTH_TOKEN=

# @sensitive=false
SENTRY_ORG=

# @sensitive=false
SENTRY_PROJECT=

# @sensitive=false
COMMIT_SHA=

# @sensitive=false
ROOT_APP=

# ---------- Email (platform marketing dispatches from Admin) ----------
# Match App when using OCI: EMAIL_PROVIDER=oci + OCI_* below.
# @type=enum(resend, oci) @sensitive=false
EMAIL_PROVIDER=resend

# @sensitive
OCI_TENANCY_OCID=

# @sensitive
OCI_USER_OCID=

# @sensitive=false
OCI_FINGERPRINT=

# @sensitive
OCI_PRIVATE_KEY=

# @sensitive=false
OCI_REGION=

# @sensitive
OCI_EMAIL_COMPARTMENT_ID=

# @sensitive=false
OCI_EMAIL_SENDER_EMAIL=

# @sensitive=false
OCI_EMAIL_SENDER_NAME=Epic Startup

# @sensitive
OCI_EMAIL_SENDER_OCID=

# @sensitive
OCI_EMAIL_LOG_OCID=

# Required when EMAIL_PROVIDER=resend (platform marketing only; transactional is on App)
# @sensitive
RESEND_API_KEY=
