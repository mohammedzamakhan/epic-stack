{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "epic-startup-admin",
	"main": "./workers/app.ts",
	"account_id": "8870705ba38bb749459b00ab2949f857",
	"compatibility_date": "2026-08-20",
	"compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
	"observability": {
		"enabled": true
	},
	"workers_dev": true,
	"assets": {
		"directory": "./build/client",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "epic_app_db",
			"database_id": "ff7f36a4-16c4-488d-bb1d-872cba6b6909",
		},
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "109ff22c36e9490d8463b4175e26a354",
		}
	],
	// Secrets (set via `wrangler secret put <NAME>`):
	//   SESSION_SECRET
	//   HONEYPOT_SECRET
	//   INTERNAL_COMMAND_TOKEN
	//   SSO_ENCRYPTION_KEY
	//   AUDIT_LOG_SECRET_KEY
	//   AWS_SECRET_ACCESS_KEY
	//   BETTERSTACK_API_KEY
	//   SENTRY_AUTH_TOKEN
	"vars": {
		"NODE_ENV": "production",
		"ALLOW_INDEXING": "false",
		"BASE_URL": "https://epic-startup-admin.zama-887.workers.dev",
		"LAUNCH_STATUS": "LAUNCHED",
		"AWS_REGION": "auto",
		"AWS_ENDPOINT_URL_S3": "https://fly.storage.tigris.dev",
		"BUCKET_NAME": "mock-bucket",
		"AWS_ACCESS_KEY_ID": "mock-access-key",
		"SENTRY_DSN": "your-dsn",
		"FLY_REGION": "",
		"FLY_APP_NAME": ""
	}
}
