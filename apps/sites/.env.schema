# Epic Stack - Organization Sites (Astro)
# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# NOTE: Astro uses import.meta.env for environment variables.
# PUBLIC_ prefix makes variables available in client-side code.
#
# @defaultRequired=infer @defaultSensitive=false
# @generateTypes(lang=ts, path=env.d.ts)
# ----------

# Main app URL used by Sites SSR to fetch published org data
# Prefer localhost in local dev to avoid proxy TLS when Sites talks to the app.
# @required @type=url @sensitive=false
PUBLIC_APP_URL=http://localhost:3001

# Root domain for cross-subdomain cookie sharing (used server-side)
# @sensitive=false
ROOT_APP=epic-startup.me

# Public root domain for client-side access
# @sensitive=false
PUBLIC_ROOT_APP=epic-startup.me

# Node.js options (for development with self-signed certs)
# @sensitive=false
NODE_OPTIONS=--use-system-ca

# Trust self-signed certificates in development
# @type=number @sensitive=false
NODE_TLS_REJECT_UNAUTHORIZED=0

# @type=boolean
DEV=true
