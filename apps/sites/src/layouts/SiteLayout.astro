---
import '../styles/tailwind.css'
import { brand } from '@repo/config/brand'
import type { PublicSiteTheme } from '~/lib/org'

interface Props {
	title?: string
	description?: string
	imageUrl?: string | null
	canonicalUrl?: string
	noIndex?: boolean
	theme?: PublicSiteTheme
	lang?: string
	dir?: 'ltr' | 'rtl'
	siteIcon?: {
		favicon32: string
		favicon16: string
		appleTouchIcon: string
	} | null
}

const {
	title = brand.name,
	description,
	imageUrl,
	canonicalUrl,
	noIndex = false,
	theme,
	lang = 'en',
	dir = 'ltr',
	siteIcon,
} = Astro.props
const themeMode = theme?.mode ?? 'system'
const themeCss = theme?.css ?? ''
const htmlClass =
	themeMode === 'dark' ? 'dark' : themeMode === 'light' ? '' : undefined
---

<!doctype html>
<html
	lang={lang}
	dir={dir}
	class={htmlClass}
	data-site-theme={theme?.theme}
	data-site-base={theme?.baseColor}
>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{description ? <meta name="description" content={description} /> : null}
		{noIndex ? <meta name="robots" content="noindex, nofollow" /> : null}
		{canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		{description ? <meta property="og:description" content={description} /> : null}
		{imageUrl ? <meta property="og:image" content={imageUrl} /> : null}
		{canonicalUrl ? <meta property="og:url" content={canonicalUrl} /> : null}
		<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={title} />
		{description ? <meta name="twitter:description" content={description} /> : null}
		{imageUrl ? <meta name="twitter:image" content={imageUrl} /> : null}
		{
			siteIcon ? (
				<>
					<link rel="icon" type="image/png" sizes="32x32" href={siteIcon.favicon32} />
					<link rel="icon" type="image/png" sizes="16x16" href={siteIcon.favicon16} />
					<link rel="apple-touch-icon" sizes="180x180" href={siteIcon.appleTouchIcon} />
				</>
			) : null
		}
		{
			themeMode === 'system' ? (
				<script is:inline>
					;(function () {
						try {
							const prefersDark = window.matchMedia(
								'(prefers-color-scheme: dark)',
							).matches
							document.documentElement.classList.toggle('dark', prefersDark)
						} catch {
							/* ignore */
						}
					})()
				</script>
			) : null
		}
		<slot name="head" />
		{/* Inject after bundled CSS so org theme tokens win over any leftover defaults. */}
		{themeCss ? (
			<style is:inline set:html={themeCss} id="org-site-theme" />
		) : null}
	</head>
	<body class="min-h-dvh antialiased">
		<slot />
	</body>
</html>
