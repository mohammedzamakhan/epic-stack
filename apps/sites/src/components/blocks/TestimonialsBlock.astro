---
import { siteContainer, siteSection } from '~/lib/media'

interface Testimonial {
	quote?: string
	name?: string
	rating?: number
}

interface Props {
	config: {
		title?: string
		subtitle?: string
		items?: Testimonial[]
	}
}

const { config } = Astro.props
const items = Array.isArray(config.items) ? config.items : []

function stars(rating: number) {
	const value = Math.min(Math.max(Math.round(rating || 0), 0), 5)
	return Array.from({ length: 5 }, (_, index) => index < value)
}
---

<section class:list={[siteSection, 'bg-muted/45']}>
	<div class={siteContainer}>
		{(config.title || config.subtitle) ? (
			<div class="mx-auto mb-12 max-w-2xl text-center">
				{config.title ? (
					<h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
						{config.title}
					</h2>
				) : null}
				{config.subtitle ? (
					<p class="mt-3 text-base text-muted-foreground">{config.subtitle}</p>
				) : null}
			</div>
		) : null}

		<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
			{items.map((item) => (
				<blockquote class="flex h-full flex-col rounded-[calc(var(--radius)+8px)] bg-background p-6 shadow-[0_8px_24px_-12px_rgba(15,23,42,0.18)]">
					<div class="mb-4 flex gap-0.5 text-primary" aria-label={`${item.rating ?? 5} out of 5 stars`}>
						{stars(item.rating ?? 5).map((filled) => (
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="16"
								height="16"
								viewBox="0 0 24 24"
								fill={filled ? 'currentColor' : 'none'}
								stroke="currentColor"
								stroke-width="1.5"
								aria-hidden="true"
							>
								<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
							</svg>
						))}
					</div>
					<p class="flex-1 text-[15px] leading-relaxed text-foreground">
						{item.quote}
					</p>
					{item.name ? (
						<footer class="mt-6 text-sm font-medium text-muted-foreground">
							{item.name}
						</footer>
					) : null}
				</blockquote>
			))}
		</div>
	</div>
</section>
