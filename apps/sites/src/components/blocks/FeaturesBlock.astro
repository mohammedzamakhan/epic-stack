---
import { siteContainer, siteSection } from '~/lib/media'

interface FeatureItem {
	title?: string
	description?: string
}

interface Props {
	config: {
		title?: string
		subtitle?: string
		items?: FeatureItem[]
	}
}

const { config } = Astro.props
const items = Array.isArray(config.items) ? config.items : []
---

<section class={siteSection}>
	<div class={siteContainer}>
		{(config.title || config.subtitle) ? (
			<div class="mx-auto mb-12 max-w-2xl text-center">
				{config.title ? (
					<h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
						{config.title}
					</h2>
				) : null}
				{config.subtitle ? (
					<p class="mt-3 text-base text-muted-foreground">{config.subtitle}</p>
				) : null}
			</div>
		) : null}

		<div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
			{items.map((item) => (
				<div>
					<h3 class="text-xl font-semibold tracking-tight text-foreground">{item.title}</h3>
					{item.description ? (
						<p class="mt-3 text-sm leading-relaxed text-muted-foreground">
							{item.description}
						</p>
					) : null}
				</div>
			))}
		</div>
	</div>
</section>
