---
import { resolveSiteLink, siteLinkHasDestination } from '@repo/common/site-link'
import { resolveMediaUrl, siteContainer, siteSection } from '~/lib/media'

interface CardItem {
	title?: string
	description?: string
	imageUrl?: string
	linkUrl?: unknown
	ctaLabel?: string
}

interface Props {
	config: {
		title?: string
		items?: CardItem[]
	}
}

const { config } = Astro.props
const items = Array.isArray(config.items) ? config.items : []
---

<section class={siteSection}>
	<div class={siteContainer}>
		{config.title ? (
			<h2 class="mb-10 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
				{config.title}
			</h2>
		) : null}

		<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{items.map((item) => {
				const src = resolveMediaUrl(item.imageUrl)
				const linked = siteLinkHasDestination(item.linkUrl)
				const resolved = resolveSiteLink(item.linkUrl)
				const inner = (
					<>
						{src ? (
							<div class="aspect-[4/3] overflow-hidden rounded-[calc(var(--radius)+8px)] bg-muted">
								<img
									src={src}
									alt={item.title || ''}
									class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
									loading="lazy"
								/>
							</div>
						) : null}
						<div class="pt-4">
							{item.title ? (
								<h3 class="text-lg font-semibold tracking-tight text-foreground">
									{item.title}
								</h3>
							) : null}
							{item.description ? (
								<p class="mt-2 text-sm leading-relaxed text-muted-foreground">
									{item.description}
								</p>
							) : null}
							{item.ctaLabel ? (
								<p class="mt-3 text-sm font-semibold text-primary">{item.ctaLabel}</p>
							) : null}
						</div>
					</>
				)

				return linked ? (
					<a
						href={resolved.href}
						class="group block overflow-hidden no-underline"
						target={resolved.target}
						rel={resolved.rel}
					>
						{inner}
					</a>
				) : (
					<div class="group overflow-hidden">{inner}</div>
				)
			})}
		</div>
	</div>
</section>
