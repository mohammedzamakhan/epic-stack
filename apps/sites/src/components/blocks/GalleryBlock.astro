---
import {
	isVideoMediaUrl,
	resolveMediaUrl,
	siteContainer,
	siteSection,
	siteSectionBackground,
	siteSectionBodyClass,
	siteSectionHeadingClass,
} from '~/lib/media'

interface GalleryItem {
	url?: string
	alt?: string
	caption?: string
	type?: 'image' | 'video' | string
}

interface Props {
	config: {
		title?: string
		subtitle?: string
		columns?: number
		imageShape?: 'rounded' | 'circle' | 'square'
		gap?: 'none' | 'sm' | 'md' | 'lg'
		background?: 'none' | 'muted' | 'inverted'
		images?: GalleryItem[]
	}
}

const { config } = Astro.props
const images = Array.isArray(config.images) ? config.images : []
const background = siteSectionBackground(config.background)
const headingClass = siteSectionHeadingClass(config.background)
const bodyClass = siteSectionBodyClass(config.background)
const columns = Math.min(Math.max(Number(config.columns) || 3, 2), 4)
const gapClass =
	config.gap === 'none'
		? 'gap-0'
		: config.gap === 'sm'
			? 'gap-2'
			: config.gap === 'lg'
				? 'gap-8'
				: 'gap-4 sm:gap-6'
const colClass =
	columns === 2
		? 'grid-cols-2'
		: columns === 4
			? 'grid-cols-2 sm:grid-cols-4'
			: 'grid-cols-2 sm:grid-cols-3'
const shapeClass =
	config.imageShape === 'circle'
		? 'rounded-full'
		: config.imageShape === 'square'
			? 'rounded-none'
			: 'rounded-[calc(var(--radius)+4px)]'
---

<section class:list={[siteSection, background]}>
	<div class={siteContainer}>
		{(config.title || config.subtitle) ? (
			<div class="mb-10 max-w-2xl">
				{config.title ? (
					<h2 class:list={['text-3xl font-bold tracking-tight sm:text-4xl', headingClass]}>
						{config.title}
					</h2>
				) : null}
				{config.subtitle ? (
					<p class:list={['mt-3 text-base', bodyClass]}>{config.subtitle}</p>
				) : null}
			</div>
		) : null}

		<div class:list={['grid', colClass, gapClass]}>
			{images.map((item) => {
				const src = resolveMediaUrl(item.url)
				const isVideo = item.type === 'video' || isVideoMediaUrl(item.url)
				return (
					<figure class="min-w-0">
						<div class:list={['aspect-square overflow-hidden bg-muted', shapeClass]}>
							{src && isVideo ? (
								<video
									src={src}
									class="size-full object-cover"
									muted
									loop
									playsinline
									autoplay
									aria-label={item.alt || item.caption || 'Gallery video'}
								/>
							) : src ? (
								<img
									src={src}
									alt={item.alt || item.caption || ''}
									class="size-full object-cover"
									loading="lazy"
								/>
							) : (
								<div class="flex size-full items-center justify-center text-sm text-muted-foreground">
									{isVideo ? 'Video' : 'Photo'}
								</div>
							)}
						</div>
						{item.caption ? (
							<figcaption class:list={['mt-3 text-center text-sm font-medium', headingClass]}>
								{item.caption}
							</figcaption>
						) : null}
					</figure>
				)
			})}
		</div>
	</div>
</section>
