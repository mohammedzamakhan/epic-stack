---
import { siteContainer, siteSection } from '~/lib/media'

interface FaqItem {
	question?: string
	answer?: string
}

interface Props {
	config: {
		title?: string
		subtitle?: string
		items?: FaqItem[]
	}
}

const { config } = Astro.props
const items = Array.isArray(config.items) ? config.items : []
---

<section class={siteSection}>
	<div class:list={[siteContainer, 'max-w-3xl']}>
		{(config.title || config.subtitle) ? (
			<div class="mb-10 text-center">
				{config.title ? (
					<h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
						{config.title}
					</h2>
				) : null}
				{config.subtitle ? (
					<p class="mt-3 text-base text-muted-foreground">{config.subtitle}</p>
				) : null}
			</div>
		) : null}

		<div class="divide-y divide-border border-y border-border">
			{items.map((item) => (
				<details class="group py-1">
					<summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-left text-base font-medium text-foreground marker:content-none [&::-webkit-details-marker]:hidden">
						<span>{item.question}</span>
						<svg
							class="size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45"
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<line x1="12" x2="12" y1="5" y2="19"></line>
							<line x1="5" x2="19" y1="12" y2="12"></line>
						</svg>
					</summary>
					<div class="pb-5 pr-8 text-sm leading-relaxed text-muted-foreground">
						<p>{item.answer}</p>
					</div>
				</details>
			))}
		</div>
	</div>
</section>
