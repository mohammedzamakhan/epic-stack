---
/**
 * Injects Google Analytics 4 via Partytown (off-main-thread).
 * Mirrors the PostHog pattern used in apps/web.
 *
 * Only renders when a valid Measurement ID (G-XXXXXXXXXX) is provided.
 */
interface Props {
	measurementId?: string | null
}

const { measurementId } = Astro.props
const enabled = Boolean(measurementId && /^G-[A-Z0-9]+$/.test(measurementId))
const idJson = JSON.stringify(measurementId ?? '').replace(/</g, '\\u003c')
const gaScriptUrl = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`
---

{
	enabled && (
		<>
			{/* Load the gtag.js library off-thread via Partytown */}
			<script is:inline type="text/partytown" src={gaScriptUrl} />
			{/* Initialise gtag with the Measurement ID */}
			<script
				is:inline
				type="text/partytown"
				set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config',${idJson});`}
			/>
		</>
	)
}
