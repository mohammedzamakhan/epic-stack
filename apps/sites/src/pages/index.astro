---
import { getPageTitle } from '@repo/config/brand'
import SiteLayout from '~/layouts/SiteLayout.astro'
import {
	fetchPublishedOrganization,
	fetchPublishedOrganizationByHost,
} from '~/lib/org'

const orgSlug = Astro.locals.orgSlug
const customHost = Astro.locals.customHost

if (!orgSlug && !customHost) {
	return new Response('Not Found', { status: 404, statusText: 'Not Found' })
}

const organization = orgSlug
	? await fetchPublishedOrganization(orgSlug)
	: await fetchPublishedOrganizationByHost(customHost!)

if (!organization) {
	return new Response('Not Found', { status: 404, statusText: 'Not Found' })
}

const theme = organization.theme
const baseLabel = theme?.baseColor ?? 'neutral'
const themeLabel = theme?.theme ?? 'neutral'
const radiusLabel = theme?.radius ?? 'default'
const modeLabel = theme?.mode ?? 'system'
---

<SiteLayout title={getPageTitle(organization.name)} theme={organization.theme}>
	<main class="bg-background text-foreground flex min-h-dvh flex-col">
		<section class="mx-auto flex w-full max-w-3xl flex-1 flex-col justify-center gap-10 px-6 py-16">
			<div class="text-center">
				<p class="text-muted-foreground mb-3 text-sm font-medium tracking-wide uppercase">
					{organization.slug}
				</p>
				<h1 class="font-title text-foreground text-4xl tracking-tight sm:text-5xl">
					{organization.name}
				</h1>
				{organization.customDomain ? (
					<p class="text-muted-foreground mt-4 text-sm">
						{organization.customDomain}
					</p>
				) : null}
			</div>

			<div class="border-border bg-card text-card-foreground space-y-6 rounded-[var(--radius)] border p-6 shadow-sm">
				<div class="flex flex-wrap items-center justify-between gap-3">
					<div>
						<p class="text-muted-foreground text-xs font-medium tracking-wide uppercase">
							Active theme
						</p>
						<p class="mt-1 text-sm font-medium capitalize">
							Base {baseLabel} · Theme {themeLabel}
						</p>
					</div>
					<p class="text-muted-foreground text-xs capitalize">
						Radius {radiusLabel} · {modeLabel}
					</p>
				</div>

				<div class="flex flex-wrap gap-2">
					<span class="bg-primary text-primary-foreground inline-flex items-center rounded-[var(--radius)] px-4 py-2 text-sm font-medium">
						Primary
					</span>
					<span class="bg-secondary text-secondary-foreground border-border inline-flex items-center rounded-[var(--radius)] border px-4 py-2 text-sm">
						Secondary
					</span>
					<span class="bg-muted text-muted-foreground inline-flex items-center rounded-[var(--radius)] px-4 py-2 text-sm">
						Muted
					</span>
					<span class="bg-accent text-accent-foreground inline-flex items-center rounded-[var(--radius)] px-4 py-2 text-sm">
						Accent
					</span>
					<span class="bg-destructive text-white inline-flex items-center rounded-[var(--radius)] px-4 py-2 text-sm">
						Destructive
					</span>
				</div>

				<div class="space-y-2">
					<p class="text-muted-foreground text-xs font-medium tracking-wide uppercase">
						Chart colors
					</p>
					<div class="flex flex-wrap gap-2">
						<span class="bg-chart-1 size-8 rounded-[calc(var(--radius)*0.6)]" title="chart-1"></span>
						<span class="bg-chart-2 size-8 rounded-[calc(var(--radius)*0.6)]" title="chart-2"></span>
						<span class="bg-chart-3 size-8 rounded-[calc(var(--radius)*0.6)]" title="chart-3"></span>
						<span class="bg-chart-4 size-8 rounded-[calc(var(--radius)*0.6)]" title="chart-4"></span>
						<span class="bg-chart-5 size-8 rounded-[calc(var(--radius)*0.6)]" title="chart-5"></span>
					</div>
				</div>

				<div class="border-border bg-background rounded-[var(--radius)] border p-4">
					<p class="text-foreground text-sm font-medium">Surface preview</p>
					<p class="text-muted-foreground mt-1 text-sm">
						Background, card, border, and radius tokens from your Website theme
						settings.
					</p>
					<div class="mt-4">
						<button
							type="button"
							class="bg-primary text-primary-foreground hover:opacity-90 rounded-[var(--radius)] px-4 py-2 text-sm font-medium transition-opacity"
						>
							Call to action
						</button>
					</div>
				</div>
			</div>
		</section>
	</main>
</SiteLayout>
