---
import { ENV } from 'varlock/env'
import { getPageTitle } from '@repo/config/brand'
import SitePage from '~/components/SitePage.astro'
import RenderBlocks from '~/components/blocks/RenderBlocks.astro'
import { fetchPublishedSitePage } from '~/lib/org'

const orgSlug = Astro.locals.orgSlug
const customHost = Astro.locals.customHost
const requestedLocale = Astro.locals.requestedLocale
let organization = Astro.locals.organization

if (!organization) {
	return new Response('Not Found', { status: 404, statusText: 'Not Found' })
}

let page = await (Astro.locals.publishedPagePromise ??
	fetchPublishedSitePage({
		slug: orgSlug,
		host: customHost,
		home: true,
		preview: Astro.url.searchParams.get('preview') === 'true',
		lng: requestedLocale,
	}))


if (page && Astro.url.searchParams.get('preview') === 'true') {
	const sectionsCookie = Astro.cookies.get('epic_preview_sections')?.value
	const themeCookie = Astro.cookies.get('epic_preview_theme')?.value

	if (sectionsCookie) {
		try {
			page.sections = JSON.parse(decodeURIComponent(sectionsCookie))
		} catch (err) {}
	}
	if (themeCookie) {
		try {
			organization.theme = JSON.parse(decodeURIComponent(themeCookie))
		} catch (err) {}
	}
}

const seoTitle = page?.seo?.title || page?.title
const pageTitle = seoTitle
	? getPageTitle(`${seoTitle} - ${organization.name}`)
	: getPageTitle(organization.name)
const seoDescription = page?.seo?.description || undefined
const appOrigin = (ENV.PUBLIC_APP_URL || 'http://localhost:3001').replace(
	/\/$/,
	'',
)
const rawSeoImage = page?.seo?.imageUrl || null
const seoImageUrl = rawSeoImage
	? rawSeoImage.startsWith('http')
		? rawSeoImage
		: `${appOrigin}${rawSeoImage}`
	: null
const seoNoIndex = page?.seo?.noIndex ?? false
---

<SitePage
	organization={organization}
	page={page}
	title={pageTitle}
	description={seoDescription}
	imageUrl={seoImageUrl}
	noIndex={seoNoIndex}
>
	{
		page ? (
			<RenderBlocks sections={page.sections} />
		) : (
			<section class="mx-auto flex min-h-[50vh] w-full max-w-3xl flex-col justify-center px-6 py-24">
				<p class="text-muted-foreground text-sm font-medium">
					{organization.slug}
				</p>
				<h1 class="text-foreground mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
					{organization.name}
				</h1>
			</section>
		)
	}
</SitePage>
