---
import SitePage from '~/components/SitePage.astro'
import {
	fetchPublishedOrganization,
	fetchPublishedOrganizationByHost,
} from '~/lib/org'

const orgSlug = Astro.locals.orgSlug
const customHost = Astro.locals.customHost
const requestedLocale = Astro.url.searchParams.get('lng')

const organization = orgSlug
	? await fetchPublishedOrganization(orgSlug, requestedLocale)
	: await fetchPublishedOrganizationByHost(customHost!, requestedLocale)

if (!organization) {
	return new Response('Not Found', { status: 404 })
}
---

<SitePage
	organization={organization}
	page={{ id: 'profile', title: 'Profile', slug: 'profile', isHomePage: false, sections: [] }}
	title={`Your Profile - ${organization.name}`}
>
	<div id="profile-container" class="mx-auto flex min-h-[60vh] w-full max-w-sm flex-col items-center justify-center px-4 py-12">
		<div class="w-full rounded-xl border border-border bg-card p-6 shadow-sm sm:p-8">
			<div class="mb-6 flex flex-col space-y-2 text-center">
				<h1 class="font-heading text-2xl font-semibold tracking-tight text-foreground">
					Your Profile
				</h1>
				<p class="text-sm text-muted-foreground">
					Update your basic details below.
				</p>
			</div>

			<form id="profile-form" class="space-y-4">
				<div class="space-y-2">
					<label for="name" class="text-sm font-medium leading-none text-foreground">
						Name
					</label>
					<input
						type="text"
						id="name"
						name="name"
						required
						placeholder="Jane Doe"
						class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm text-foreground ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
					/>
				</div>

				<div class="space-y-2">
					<label for="email" class="text-sm font-medium leading-none text-foreground">
						Email
					</label>
					<input
						type="email"
						id="email"
						name="email"
						placeholder="jane@example.com"
						class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm text-foreground ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
					/>
				</div>

				<div class="space-y-2">
					<label for="phone" class="text-sm font-medium leading-none text-foreground">
						Phone Number
					</label>
					<input
						type="tel"
						id="phone"
						name="phone"
						required
						readonly
						disabled
						placeholder="+1234567890"
						class="flex h-10 w-full rounded-md border border-input bg-muted/50 px-3 py-2 text-sm text-muted-foreground ring-offset-background cursor-not-allowed opacity-75"
					/>
					<p class="text-xs text-muted-foreground">
						Phone number cannot be changed at this time.
					</p>
				</div>

				<div id="error-message" class="hidden text-sm font-medium text-destructive"></div>
				<div id="success-message" class="hidden text-sm font-medium text-green-500">Profile updated successfully!</div>

				<button
					type="submit"
					id="submit-button"
					class="inline-flex h-10 w-full items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground ring-offset-background transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50"
				>
					Save Changes
				</button>
			</form>
		</div>
	</div>

	<script>
		import { tenantFetch, setSessionTokens } from '~/lib/client-auth'

		const form = document.getElementById('profile-form') as HTMLFormElement
		const errorMessage = document.getElementById('error-message')!
		const successMessage = document.getElementById('success-message')!
		const submitButton = document.getElementById('submit-button') as HTMLButtonElement
		const nameInput = document.getElementById('name') as HTMLInputElement
		const emailInput = document.getElementById('email') as HTMLInputElement
		const phoneInput = document.getElementById('phone') as HTMLInputElement

		async function loadProfile() {
			try {
				const res = await tenantFetch('/auth/me')
				if (res.status === 401) {
					window.location.replace('/login')
					return
				}
				if (res.ok) {
					const data = await res.json()
					if (data.customer) {
						if (data.customer.name && nameInput) nameInput.value = data.customer.name
						if (data.customer.email && emailInput) emailInput.value = data.customer.email
						if (data.customer.phone && phoneInput) phoneInput.value = data.customer.phone
					}
				}
			} catch (err) {
				console.error('Failed to load profile:', err)
			}
		}

		loadProfile()

		form?.addEventListener('submit', async (e) => {
			e.preventDefault()

			const formData = new FormData(form)
			const name = formData.get('name')?.toString() || ''
			const email = formData.get('email')?.toString() || ''

			errorMessage.classList.add('hidden')
			successMessage.classList.add('hidden')

			submitButton.disabled = true
			submitButton.textContent = 'Saving...'

			try {
				const res = await tenantFetch('/auth/profile', {
					method: 'POST',
					body: JSON.stringify({ name, email }),
				})
				if (res.status === 401) {
					window.location.replace('/login')
					return
				}
				const data = await res.json()

				if (res.ok) {
					setSessionTokens({
						accessToken:
							typeof data.accessToken === 'string' ? data.accessToken : undefined,
						refreshToken:
							typeof data.refreshToken === 'string'
								? data.refreshToken
								: undefined,
					})
					successMessage.classList.remove('hidden')
				} else {
					errorMessage.textContent = data.error || 'Something went wrong.'
					errorMessage.classList.remove('hidden')
				}
			} catch {
				errorMessage.textContent = 'Network error. Please try again.'
				errorMessage.classList.remove('hidden')
			} finally {
				submitButton.disabled = false
				submitButton.textContent = 'Save Changes'
			}
		})
	</script>
</SitePage>
