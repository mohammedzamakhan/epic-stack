---
import SitePage from '~/components/SitePage.astro'
import {
	fetchPublishedOrganization,
	fetchPublishedOrganizationByHost,
} from '~/lib/org'

const orgSlug = Astro.locals.orgSlug
const customHost = Astro.locals.customHost
const requestedLocale = Astro.url.searchParams.get('lng')

const organization = orgSlug
	? await fetchPublishedOrganization(orgSlug, requestedLocale)
	: await fetchPublishedOrganizationByHost(customHost!, requestedLocale)

if (!organization) {
	return new Response('Not Found', { status: 404 })
}
---

<SitePage
	organization={organization}
	page={{ id: 'complete-name', title: 'Your name', slug: 'complete-name', isHomePage: false, sections: [] }}
	title={`Your name - ${organization.name}`}
>
	<div id="complete-name-container" class="mx-auto flex min-h-[60vh] w-full max-w-sm flex-col items-center justify-center px-4">
		<div class="w-full rounded-xl border border-border bg-card p-6 shadow-sm sm:p-8">
			<div class="mb-6 flex flex-col space-y-2 text-center">
				<h1 class="font-heading text-2xl font-semibold tracking-tight text-foreground">
					What's your name?
				</h1>
				<p class="text-sm text-muted-foreground">
					We'll use this on your profile. You can change it later.
				</p>
			</div>

			<form id="complete-name-form" class="space-y-4">
				<div class="space-y-2">
					<label for="name" class="text-sm font-medium leading-none text-foreground">
						Full name
					</label>
					<input
						type="text"
						id="name"
						name="name"
						placeholder="Jane Doe"
						required
						minlength="2"
						autocomplete="name"
						class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm text-foreground ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
					/>
				</div>

				<div id="error-message" class="hidden text-sm font-medium text-destructive"></div>

				<button
					type="submit"
					class="inline-flex h-10 w-full items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground ring-offset-background transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50"
				>
					Continue
				</button>
			</form>
		</div>
	</div>
</SitePage>

<script>
	import {
		getAccessToken,
		setSessionTokens,
		tenantErrorMessage,
		tenantFetch,
	} from '~/lib/client-auth'

	if (!getAccessToken()) {
		window.location.replace('/login')
	}

	const form = document.getElementById('complete-name-form') as HTMLFormElement
	const errorMessage = document.getElementById('error-message')!
	const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement

	async function skipIfNamed() {
		try {
			const res = await tenantFetch('/auth/me')
			if (res.status === 401) {
				window.location.replace('/login')
				return
			}
			if (!res.ok) return
			const data = (await res.json()) as {
				customer?: { needsName?: boolean; name?: string }
			}
			if (data.customer && data.customer.needsName !== true) {
				window.location.replace('/')
			}
		} catch {
			// Stay on the form if profile cannot be loaded
		}
	}

	void skipIfNamed()

	form.addEventListener('submit', async (e) => {
		e.preventDefault()
		errorMessage.classList.add('hidden')
		submitButton.disabled = true
		submitButton.textContent = 'Saving...'

		const name = new FormData(form).get('name')?.toString().trim() || ''

		try {
			const res = await tenantFetch('/auth/profile', {
				method: 'POST',
				body: JSON.stringify({ name }),
			})
			if (res.status === 401) {
				window.location.replace('/login')
				return
			}
			const data = (await res.json().catch(() => ({}))) as Record<string, unknown>
			if (res.ok) {
				setSessionTokens({
					accessToken:
						typeof data.accessToken === 'string' ? data.accessToken : undefined,
					refreshToken:
						typeof data.refreshToken === 'string' ? data.refreshToken : undefined,
				})
				window.location.href = '/'
			} else {
				errorMessage.textContent = tenantErrorMessage(data, 'Something went wrong.')
				errorMessage.classList.remove('hidden')
			}
		} catch {
			errorMessage.textContent = 'Network error. Please try again.'
			errorMessage.classList.remove('hidden')
		} finally {
			submitButton.disabled = false
			submitButton.textContent = 'Continue'
		}
	})
</script>
