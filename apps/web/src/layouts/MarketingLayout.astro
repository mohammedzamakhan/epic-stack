---
import Footer from '~/components/Footer.astro'
import Header from '~/components/Header.astro'
import Banner from '~/components/Banner.astro'
import Frame from '~/components/site/Frame.astro'
import '../styles/tailwind.css'
import { getThemeFromCookie } from '~/utils/theme'
import {
	getBanner,
	getFooterMenuColumns,
	getPrimaryMenu,
	getSiteSettings,
} from '~/lib/emdash'

import { getDirection } from '@repo/i18n'

const currentLocale = Astro.currentLocale ?? 'en'
const dir = getDirection(currentLocale)

const cookieHeader = Astro.request.headers.get('cookie')
const theme = getThemeFromCookie(cookieHeader)

const [settings, primaryMenu, footerColumns, banner] = await Promise.all([
	getSiteSettings(),
	getPrimaryMenu(currentLocale),
	getFooterMenuColumns(currentLocale),
	getBanner(currentLocale),
])

const isBannerEnabled: boolean = Boolean((banner as any)?.isEnabled)
---

<html class={theme} lang={currentLocale} dir={dir}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="theme-color" content={theme === 'dark' ? '#12140f' : '#fbfbf9'} />

		<link rel="preconnect" href="https://cdn.magicui.design" crossorigin />
		<link rel="dns-prefetch" href="https://cdn.magicui.design" />

		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/svg+xml" href="/favicons/favicon.svg" />
		<link rel="apple-touch-icon" href="/favicons/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" crossorigin="use-credentials" />

		<slot name="head" />
	</head>
	<body class="min-h-screen bg-background">
		<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-background focus:px-4 focus:py-2 focus:rounded">Skip to main content</a>
		<Banner />
		<Header
			bannerEnabled={isBannerEnabled}
			settings={settings}
			primaryMenu={primaryMenu}
		/>
		<main id="main-content" class="min-h-screen">
			<Frame>
				<slot />
				<Footer settings={settings} footerColumns={footerColumns} />
			</Frame>
		</main>
	</body>
</html>
