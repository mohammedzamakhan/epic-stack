---
import MarketingLayout from '../../../layouts/MarketingLayout.astro'
import SEO from '../../../components/SEO.astro'
import { getPageTitle, brand } from '@repo/config/brand'
import GridDesign from '../../../components/GridDesign.astro'
import { getEmDashCollection } from 'emdash'



const { page } = Astro.params
const pageNumber = parseInt(page as string) || 1
const limit = 12

const { entries, hasMore } = await getEmDashCollection('posts', {
	limit: limit,
	offset: (pageNumber - 1) * limit,
})

// Breadcrumbs for SEO
const breadcrumbs = [
	{ name: 'Home', url: '/' },
	{ name: 'Blog', url: '/blog' },
	...(pageNumber > 1 ? [{ name: `Page ${pageNumber}`, url: `/blog/page/${pageNumber}` }] : []),
]

const pageTitle = pageNumber === 1 
	? getPageTitle('Blog') 
	: getPageTitle(`Blog - Page ${pageNumber}`)

const pageDescription = `Discover the latest insights, tutorials, and updates from ${brand.name}. Learn about best practices and product updates.`
---

<MarketingLayout>
	<Fragment slot="head">
		<SEO
			title={pageTitle}
			description={pageDescription}
			breadcrumbs={breadcrumbs}
		/>
		{pageNumber > 1 && <link rel="prev" href={pageNumber === 2 ? '/blog' : `/blog/page/${pageNumber - 1}`} />}
		{hasMore && <link rel="next" href={`/blog/page/${pageNumber + 1}`} />}
	</Fragment>

	<main class="relative min-h-screen py-24">
		<GridDesign />
		<div class="container mx-auto px-4 mb-16">
			<div class="prose dark:prose-invert max-w-none">
				<h1 class="text-4xl font-bold text-center mb-8 font-title">Blog Posts</h1>
				<p class="text-xl text-center text-gray-600 mb-12">
					Discover the latest insights and updates from our team - Page {
						pageNumber
					}
				</p>
			</div>
		</div>

		{
			entries && entries.length > 0 ? (
				<div class="container mx-auto px-6">
					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
						{entries.map((post) => (
							<article class="border border-border overflow-hidden bg-background hover:shadow-lg transition-shadow relative z-1">
								{post.data.meta?.image && (
									<img
										src={`${post.data.meta.image.url}`}
										alt={post.data.meta.image.alt || post.data.title}
										class="w-full h-48 object-cover"
									/>
								)}
								<div class="p-6">
									{post.data.categories && post.data.categories.length > 0 && (
										<div class="mb-4">
											{post.data.categories.map((category) => (
												<span class="inline-block bg-blue-100 text-blue-800 text-sm px-3 py-1 rounded-full mr-2">
													{typeof category === 'object'
														? category.title
														: category}
												</span>
											))}
										</div>
									)}
									<h2 class="text-xl font-semibold mb-3">
										<a
											href={`/blog/${post.id}`}
											class="hover:text-primary font-title transition-colors"
											set:html={post.data.title}
										/>
									</h2>
									{post.data.meta?.description && (
										<p
											class="text-gray-600 mb-4"
											set:html={post.data.meta.description}
										/>
									)}
									<div class="flex justify-between items-center text-sm text-gray-500">
										{post.data.publishedAt && (
											<time datetime={post.data.publishedAt}>
												{new Date(post.data.publishedAt).toLocaleDateString(
													'en-US',
													{
														year: 'numeric',
														month: 'long',
														day: 'numeric',
													},
												)}
											</time>
										)}
										<a
											href={`/blog/${post.id}`}
											class="text-primary hover:text-primary/80 font-medium"
										>
											Read more →
										</a>
									</div>
								</div>
							</article>
						))}
					</div>

					{/* Simple pagination - following guide pattern */}
					{(pageNumber > 1 || hasMore) && (
						<div class="flex justify-center items-center mt-12 space-x-4">
							{pageNumber > 1 && (
								<a
									href={
										pageNumber === 2
											? '/blog'
											: `/blog/page/${pageNumber - 1}`
									}
									class="px-4 py-2 bg-primary text-white rounded hover:bg-blue-700"
								>
									Previous
								</a>
							)}
							<span class="px-4 py-2">
								Page {pageNumber}
							</span>
							{hasMore && (
								<a
									href={`/blog/page/${pageNumber + 1}`}
									class="px-4 py-2 bg-primary text-white rounded hover:bg-blue-700"
								>
									Next
								</a>
							)}
						</div>
					)}
				</div>
			) : (
				<div class="container mx-auto px-4 text-center">
					<p class="text-gray-600 text-lg">No posts found.</p>
				</div>
			)
		}
	</main>
</MarketingLayout>
