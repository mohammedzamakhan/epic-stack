---
import MarketingLayout from '../../layouts/MarketingLayout.astro'
import PostContent from '../../components/PostContent.astro'
import SEO from '../../components/SEO.astro'
import { getEmDashEntry } from 'emdash'

const { slug } = Astro.params

const { entry: post } = await getEmDashEntry('posts', slug || '')

if (!post) {
	return Astro.redirect('/404')
}

const { title, content, meta, publishedAt, updatedAt, categories, heroImage } = post.data

// Calculate reading time (average 200 words per minute)
function calculateReadingTime(content: unknown): number {
	if (!content) return 3
	const text = JSON.stringify(content)
	const words = text.split(/\s+/).length
	return Math.max(1, Math.ceil(words / 200))
}

const readingTime = calculateReadingTime(content)

// Breadcrumbs for SEO
const breadcrumbs = [
	{ name: 'Home', url: '/' },
	{ name: 'Blog', url: '/blog' },
	{ name: title as string, url: `/blog/${slug}` },
]
---

<MarketingLayout>
	<Fragment slot="head">
		<SEO
			title={meta?.title || title}
			description={meta?.description || undefined}
			image={meta?.image || heroImage}
			type="article"
			publishedTime={publishedAt || undefined}
			modifiedTime={updatedAt}
			keywords={categories?.map((cat: { title: string }) => cat.title) || []}
			breadcrumbs={breadcrumbs}
			readingTime={readingTime}
		/>
	</Fragment>

	<PostContent 
		title={title}
		content={content}
		meta={meta as any}
		publishedAt={publishedAt || undefined}
		categories={categories as any}
		heroImage={heroImage}
	/>
</MarketingLayout>
