---
import MarketingLayout from '../../../layouts/MarketingLayout.astro'
import { getPosts } from '../../../lib/emdash'
import SEO from '../../../components/SEO.astro'
import Button from '../../../components/ui/Button.astro'
import { getPageTitle, brand } from '@repo/config/brand'

const { page } = Astro.params
const pageNumber = parseInt(page as string)
const currentLocale = Astro.currentLocale ?? 'en'

let posts = await getPosts(pageNumber, 12, currentLocale)
if ((!posts.entries || posts.entries.length === 0) && currentLocale !== 'en') {
  posts = await getPosts(pageNumber, 12, 'en')
}
if (!posts.entries || posts.entries.length === 0) {
  posts = await getPosts(pageNumber, 12)
}

const breadcrumbs = [
	{ name: 'Home', url: '/' },
	{ name: 'Blog', url: '/posts' },
	...(pageNumber > 1 ? [{ name: `Page ${pageNumber}`, url: `/posts/page/${pageNumber}` }] : []),
]

const pageTitle = pageNumber === 1 
	? getPageTitle('Blog') 
	: getPageTitle(`Blog - Page ${pageNumber}`)

const pageDescription = `Discover the latest insights, tutorials, and updates from ${brand.name}.`
---

<MarketingLayout>
	<Fragment slot="head">
		<SEO
			title={pageTitle}
			description={pageDescription}
			breadcrumbs={breadcrumbs}
		/>
		{pageNumber > 1 && <link rel="prev" href={pageNumber === 2 ? '/posts' : `/posts/page/${pageNumber - 1}`} />}
		{posts.totalPages > pageNumber && <link rel="next" href={`/posts/page/${pageNumber + 1}`} />}
	</Fragment>

	<main class="px-5 pt-28 pb-20 sm:px-8 sm:pt-32">
		<div class="mx-auto max-w-3xl text-center">
			<p class="text-[13px] font-medium text-brand">Blog</p>
			<h1 class="mt-3 font-display text-[40px] font-medium tracking-[-0.03em] text-foreground sm:text-[52px]">
				Latest posts
			</h1>
			<p class="mt-4 text-[17px] text-muted-foreground">
				Page {pageNumber}
			</p>
		</div>

		{
			posts.entries && posts.entries.length > 0 ? (
				<div class="mx-auto mt-12 max-w-6xl">
					<div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
						{posts.entries.map((post) => {
							const imageUrl = (post as any).heroImage?.url || post.seo?.image?.url
							const imageAlt = (post as any).heroImage?.alt || post.seo?.image?.alt || post.title
							const category = (post as any).category || 'Blog'
							const publishedDate = post.publishedAt
								? new Date(post.publishedAt).toLocaleDateString('en-US', {
										year: 'numeric',
										month: 'long',
									})
								: undefined

							return (
								<a href={`/posts/${post.slug}`} class="group flex flex-col">
									{imageUrl && (
										<div class="relative aspect-[4/3] w-full overflow-hidden rounded-2xl border border-hairline">
											<img
												src={imageUrl}
												alt={imageAlt}
												class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
												loading="lazy"
											/>
										</div>
									)}
									<div class="mt-5 flex items-center gap-3">
										<span class="rounded-full border border-hairline px-3 py-1 text-[12px] font-medium text-muted-foreground">
											{category}
										</span>
										{publishedDate && (
											<span class="text-[13px] text-muted-foreground">{publishedDate}</span>
										)}
									</div>
									<h2 class="mt-3 flex items-start gap-1 text-pretty text-[18px] font-medium leading-snug tracking-[-0.01em]">
										<span set:html={post.title} />
										<svg
											xmlns="http://www.w3.org/2000/svg"
											width="16"
											height="16"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
											class="mt-1 size-4 shrink-0 text-muted-foreground transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
											aria-hidden="true"
										>
											<path d="M7 7h10v10" />
											<path d="M7 17 17 7" />
										</svg>
									</h2>
								</a>
							)
						})}
					</div>

					{posts.totalPages > 1 && (
						<div class="mt-12 flex items-center justify-center gap-3">
							{posts.page > 1 && (
								<Button
									href={posts.page === 2 ? '/posts' : `/posts/page/${posts.page - 1}`}
									variant="outline"
								>
									Previous
								</Button>
							)}
							<span class="px-2 text-[14px] text-muted-foreground">
								Page {posts.page} of {posts.totalPages}
							</span>
							{posts.page < posts.totalPages && (
								<Button href={`/posts/page/${posts.page + 1}`} variant="outline">
									Next
								</Button>
							)}
						</div>
					)}
				</div>
			) : (
				<p class="mt-12 text-center text-[17px] text-muted-foreground">No posts found.</p>
			)
		}
	</main>
</MarketingLayout>
