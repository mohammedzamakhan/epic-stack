---
import { getRelativeLocaleUrl } from 'astro:i18n'

interface Props {
	class?: string
}

const { class: className = '' } = Astro.props

const currentLocale = Astro.currentLocale ?? 'en'

const locales = [
	{ code: 'en', label: 'English', short: 'EN' },
	{ code: 'es', label: 'Español', short: 'ES' },
	{ code: 'ar', label: 'العربية', short: 'AR' },
]

// Strip existing locale prefix to get canonical pathname
const currentPathname = Astro.url.pathname.replace(/^\/(es|ar)(\/|$)/, '/')
---

<div class={`relative inline-flex items-center language-switcher ${className}`}>
	<label for="language-select" class="sr-only">Select language</label>
	<div class="relative flex items-center">
		<svg
			class="pointer-events-none absolute left-2.5 h-4 w-4 text-muted-foreground"
			fill="none"
			stroke="currentColor"
			viewBox="0 0 24 24"
			xmlns="http://www.w3.org/2000/svg"
			aria-hidden="true"
		>
			<path
				stroke-linecap="round"
				stroke-linejoin="round"
				stroke-width="2"
				d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
			></path>
		</svg>
		<select
			id="language-select"
			class="h-9 cursor-pointer appearance-none rounded-md border border-border bg-background/80 py-1 pl-8 pr-7 text-xs font-medium uppercase tracking-wider text-foreground backdrop-blur transition-colors hover:bg-accent focus:outline-none focus:ring-1 focus:ring-ring"
			aria-label="Language selector"
		>
			{
				locales.map((loc) => {
					const targetUrl = getRelativeLocaleUrl(loc.code, currentPathname)
					return (
						<option value={targetUrl} selected={loc.code === currentLocale}>
							{loc.short} - {loc.label}
						</option>
					)
				})
			}
		</select>
		<svg
			class="pointer-events-none absolute right-2 h-3.5 w-3.5 text-muted-foreground"
			fill="none"
			stroke="currentColor"
			viewBox="0 0 24 24"
			xmlns="http://www.w3.org/2000/svg"
			aria-hidden="true"
		>
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
		</svg>
	</div>
</div>

<script>
	function initLanguageSwitcher() {
		const selects = document.querySelectorAll<HTMLSelectElement>('#language-select')
		selects.forEach((select) => {
			select.addEventListener('change', () => {
				if (select.value) {
					window.location.href = select.value
				}
			})
		})
	}

	initLanguageSwitcher()
	document.addEventListener('astro:page-load', initLanguageSwitcher)
</script>
