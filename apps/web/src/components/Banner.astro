---
import { fetchBannerData } from '~/lib/fetchBanner'

// Define valid banner types
type BannerType = 'info' | 'warning' | 'error' | 'success'

// Define AriaRole type to match what Astro expects
type AriaRole = 'alert' | 'status'

const banner = await fetchBannerData()
const isEnabled = banner?.isEnabled

const type: BannerType = (banner?.type as BannerType) || 'info'
const content = banner?.content || banner?.text
const addLink = banner?.addLink || !!banner?.link
const link = banner?.link

const bgColors: Record<BannerType, string> = {
	info: 'bg-primary',
	warning: 'bg-accent',
	error: 'bg-destructive',
	success: 'bg-primary',
}

const ariaRoles: Record<BannerType, AriaRole> = {
	info: 'status',
	warning: 'alert',
	error: 'alert',
	success: 'status',
}

const textColors: Record<BannerType, string> = {
	info: 'text-primary-foreground',
	warning: 'text-accent-foreground',
	error: 'text-destructive-foreground',
	success: 'text-primary-foreground',
}
---

{
	isEnabled && (
		<div role="banner">
			<div role={ariaRoles[type]} class={`${bgColors[type]} ${textColors[type]} px-4 py-3 relative`}>
			<div class="container mx-auto flex items-center justify-between">
				<div class="flex-1 text-center text-sm font-medium flex justify-center items-center">
					<span class="flex items-center" set:html={content}></span>
					{addLink && typeof link === 'string' && (
						<>
							<span class="mx-2 mr-1 text-muted-foreground">—</span>
							<a
								href={link}
								class="ml-2 hover:text-opacity-80 transition-colors flex items-center gap-1"
							>
								Learn more
								<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5h6v6m0-6L5 19"/></svg>
							</a>
						</>
					)}
				</div>
			</div>
		</div>
		</div>
	)
}
