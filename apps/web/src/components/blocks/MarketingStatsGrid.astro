---
import StatsGrid from './StatsGrid.astro'

interface Props {
	node: {
		title?: string
		subtitle?: string
		stats?: Array<{
			value: string
			label: string
			description?: string
		}>
	}
}

const { node = {} as any } = Astro.props
const { title, subtitle, stats } = node

const mappedStats = stats?.map((s: any) => ({
	title: s.label,
	value: s.value,
	description: s.description || '',
	variant: 'default',
	colSpan: 'auto'
})) || []
---

<StatsGrid
	title={title}
	subtitle={subtitle}
	stats={mappedStats as any}
	blockType="statsGrid"
/>
