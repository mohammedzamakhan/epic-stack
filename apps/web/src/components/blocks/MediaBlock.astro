---
import Section from '../site/Section.astro'
import Reveal from '../site/Reveal.astro'

interface Props {
	media?: any
	blockType: 'mediaBlock'
}

const { media } = Astro.props
---

<Section class="py-12 sm:py-16" aria-label="Media content">
	{
		media && typeof media === 'object' && media.url && (
			<Reveal class="overflow-hidden rounded-3xl border border-hairline">
				<img
					src={media.url}
					alt={media.alt || ''}
					role={media.alt ? undefined : 'presentation'}
					class="w-full object-cover"
					loading="lazy"
					decoding="async"
					width={media.width || 1200}
					height={media.height || 720}
				/>
			</Reveal>
		)
	}
</Section>
