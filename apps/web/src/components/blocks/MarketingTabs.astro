---
import Tabs from './Tabs.astro'

interface Props {
	node: {
		title?: string
		subtitle?: string
		tabs?: Array<{
			label: string
			title?: string
			description?: string
			imageUrl?: string
		}>
	}
}

const { node = {} as any } = Astro.props
const { title, subtitle, tabs } = node

const mappedTabs = tabs?.map((t: any) => ({
	title: t.title || t.label || '',
	description: t.description || '',
	icon: t.icon || '',
	image: t.imageUrl || t.image ? { url: t.imageUrl || t.image, alt: t.title || t.label } : undefined,
}))
---

<Tabs
	title={title}
	subtitle={subtitle}
	tabs={mappedTabs as any}
	buttonText={node.buttonText || node.primaryButtonText}
	buttonUrl={node.buttonUrl || node.primaryButtonUrl}
	secondaryButtonText={node.secondaryButtonText}
	secondaryButtonUrl={node.secondaryButtonUrl}
	blockType="tabs"
/>
