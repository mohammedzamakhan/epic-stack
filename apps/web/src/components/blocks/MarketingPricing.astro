---
import Pricing from './Pricing.astro'

interface Props {
	node: {
		headline?: string
		badge?: string
		plans?: Array<{
			name: string
			monthlyPrice?: string
			yearlyPrice?: string
			price?: string // legacy support
			description?: string
			features?: string
			ctaLabel?: string
			ctaUrl?: string
			highlighted?: boolean
		}>
	}
}

const { node = {} as any } = Astro.props
const { headline, badge, plans } = node

const mappedPlans = plans?.map((p: any, idx: number) => {
	const featureLines = typeof p.features === 'string'
		? p.features.split('\n').filter(Boolean).map((f: string) => ({ name: f.trim(), icon: 'check' }))
		: []

	const rawMonthly = p.monthlyPrice || p.price || '0'
	const rawYearly = p.yearlyPrice || p.price || '0'
	const extractCurrency = (str: string) => (str.match(/^[^0-9a-zA-Z]+/) || [''])[0].trim() || '$'
	const currency = extractCurrency(rawMonthly)

	return {
		id: `plan-${idx}`,
		title: p.name || 'Plan',
		description: p.description || '',
		monthlyPrice: rawMonthly.replace(/^[^0-9a-zA-Z]+/, '').trim(),
		yearlyPrice: rawYearly.replace(/^[^0-9a-zA-Z]+/, '').trim(),
		currency: currency,
		buttonText: p.ctaLabel || 'Get Started',
		highlight: !!p.highlighted,
		badge: p.highlighted ? 'Popular' : undefined,
		features: featureLines,
	}
})
---

<Pricing
	title={headline || 'Simple, transparent pricing'}
	subtitle={badge || 'Pricing'}
	plans={mappedPlans as any}
	blockType="pricing"
/>
