---
import Button from '../ui/Button.astro'
import GridDesign from '../GridDesign.astro'

interface Props {
	node: {
		title?: string
		description?: string
		primaryButtonText?: string
		primaryButtonUrl?: string
		secondaryButtonText?: string
		secondaryButtonUrl?: string
	}
}

const { node = {} as any } = Astro.props
const {
	title = 'Ready to build faster?',
	description = 'Join thousands of developers shipping with Epic Startup today.',
	primaryButtonText = 'Get Started',
	primaryButtonUrl = '/signup',
	secondaryButtonText,
	secondaryButtonUrl,
} = node
---

<section class="relative w-full py-20 md:py-28" aria-labelledby="cta-heading">
	<GridDesign aria-hidden="true" />
	<div class="container relative mx-auto px-4 text-center">
		<div class="max-w-4xl mx-auto">
			<div class="bg-muted dark:bg-background rounded-2xl p-1">
				<div class="bg-card ring-border rounded-2lg p-8 md:p-12 shadow-sm ring-1">
					<h2 id="cta-heading" class="text-3xl md:text-5xl font-title text-foreground mb-4">
						{title}
					</h2>
					{description && (
						<p class="text-lg text-muted-foreground leading-relaxed max-w-2xl mx-auto mb-8">
							{description}
						</p>
					)}
					<div class="flex flex-wrap justify-center gap-3 mt-6">
						<Button
							href={primaryButtonUrl}
							variant="default"
							size="lg"
						>
							{primaryButtonText}
						</Button>
						{secondaryButtonText && (
							<Button
								href={secondaryButtonUrl || '#'}
								variant="secondary"
								size="lg"
							>
								{secondaryButtonText}
							</Button>
						)}
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
