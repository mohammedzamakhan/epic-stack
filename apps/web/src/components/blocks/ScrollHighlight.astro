---
import Section from '../site/Section.astro'
import SectionHead from '../site/SectionHead.astro'

interface Props {
	title?: string
	subtitle?: string
	text?: string
	highlightColor?: 'primary' | 'gradient' | 'accent'
	blockType: 'scrollHighlight'
}

const {
	title = 'How it works',
	subtitle = 'Scroll to reveal',
	text = 'As you scroll down this page, each word will progressively highlight, creating an engaging reading experience that guides your attention through the content.',
	highlightColor = 'primary',
} = Astro.props

const words = text.split(/\s+/).filter((word) => word.length > 0)
const instanceId = `scroll-highlight-${Math.random().toString(36).slice(2, 11)}`
---

<Section
	class="py-12 sm:py-16"
	id={instanceId}
	seam={true}
	aria-labelledby={title ? `${instanceId}-title` : undefined}
>
	<div
		class="scroll-highlight-section"
		data-highlight-color={highlightColor}
	>
		{(subtitle || title) && (
			<SectionHead eyebrow={subtitle || 'Highlight'} title={title || ''} />
		)}

		<div class="mt-10 max-w-4xl">
			<p class="scroll-highlight-text font-display text-[28px] font-medium leading-[1.15] tracking-[-0.02em] text-foreground sm:text-[36px] lg:text-[48px]">
				{
					words.map((word, index) => (
						<span class="scroll-word" data-word-index={index}>
							{word}
						</span>
					))
				}
			</p>
		</div>
	</div>
</Section>

<style is:global>
	.scroll-word {
		color: var(--muted-foreground);
		transition: color 0.3s ease-out;
	}

	.scroll-word::after {
		content: ' ';
	}

	.scroll-word:last-child::after {
		content: '';
	}

	.scroll-word.highlighted {
		color: var(--brand);
	}

	.scroll-highlight-section[data-highlight-color='accent'] .scroll-word.highlighted {
		color: var(--foreground);
	}

	.scroll-highlight-section[data-highlight-color='gradient'] .scroll-word.highlighted {
		color: var(--brand);
	}
</style>

<script>
	function initScrollHighlight() {
		const sections = document.querySelectorAll('.scroll-highlight-section')!

		sections.forEach((sectionEl) => {
			const section = sectionEl as HTMLElement
			const wordsNodeList = section.querySelectorAll('.scroll-word')
			const words = Array.from(wordsNodeList)

			if (words.length === 0) return
			if (section.dataset.initialized === 'true') return
			section.dataset.initialized = 'true'

			const totalWords = words.length
			const rootSection = section.closest('section') as HTMLElement | null

			function updateHighlighting() {
				if (!rootSection) return
				const rect = rootSection.getBoundingClientRect()
				const viewportHeight = window.innerHeight
				const sectionHeight = rect.height
				const sectionTop = rect.top
				const startOffset = viewportHeight * 0.8
				const endOffset = viewportHeight * 0.2
				const sectionMiddle = sectionTop + sectionHeight / 2
				const progress = 1 - (sectionMiddle - endOffset) / (startOffset - endOffset)
				const clampedProgress = Math.max(0, Math.min(1, progress))
				const wordsToHighlight = Math.floor(clampedProgress * totalWords)

				for (let i = 0; i < words.length; i++) {
					words[i].classList.toggle('highlighted', i < wordsToHighlight)
				}
			}

			window.addEventListener('scroll', updateHighlighting, { passive: true })
			updateHighlighting()
		})
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initScrollHighlight)
	} else {
		initScrollHighlight()
	}

	document.addEventListener('astro:page-load', initScrollHighlight)
	document.addEventListener('astro:after-swap', initScrollHighlight)
</script>
