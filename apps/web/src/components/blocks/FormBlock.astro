---
import Section from '../site/Section.astro'
import Button from '../ui/Button.astro'

interface Props {
	form?: any
	blockType: 'formBlock'
}

const { form } = Astro.props
const formId = typeof form === 'object' ? form.id : form
const formTitle = typeof form === 'object' ? form.title : 'Contact Us'
---

<Section class="py-16 sm:py-20">
	<div class="mx-auto max-w-xl">
		<h2 id={`form-heading-${formId}`} class="font-display text-[32px] font-medium tracking-[-0.02em] text-foreground sm:text-[40px]">
			{formTitle}
		</h2>
		<form
			id={formId}
			aria-labelledby={`form-heading-${formId}`}
			class="mt-8 space-y-5"
			method="post"
		>
			<div>
				<label for={`name-${formId}`} class="mb-2 block text-[14px] font-medium text-foreground">
					Name <span aria-hidden="true">*</span>
				</label>
				<input
					type="text"
					id={`name-${formId}`}
					name="name"
					required
					aria-required="true"
					class="h-11 w-full rounded-full border border-hairline bg-background px-4 text-[15px] outline-none focus-visible:ring-2 focus-visible:ring-brand/30"
				/>
			</div>

			<div>
				<label for={`email-${formId}`} class="mb-2 block text-[14px] font-medium text-foreground">
					Email <span aria-hidden="true">*</span>
				</label>
				<input
					type="email"
					id={`email-${formId}`}
					name="email"
					required
					aria-required="true"
					class="h-11 w-full rounded-full border border-hairline bg-background px-4 text-[15px] outline-none focus-visible:ring-2 focus-visible:ring-brand/30"
				/>
			</div>

			<div>
				<label for={`message-${formId}`} class="mb-2 block text-[14px] font-medium text-foreground">
					Message <span aria-hidden="true">*</span>
				</label>
				<textarea
					id={`message-${formId}`}
					name="message"
					required
					aria-required="true"
					rows="5"
					class="w-full rounded-3xl border border-hairline bg-background px-4 py-3 text-[15px] outline-none focus-visible:ring-2 focus-visible:ring-brand/30"
				></textarea>
			</div>

			<Button type="submit" variant="brand">
				Submit
			</Button>
		</form>
	</div>
</Section>
