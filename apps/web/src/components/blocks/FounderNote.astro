---
import GridDesign from '../GridDesign.astro'

interface Props {
	heading: string
	content: any
	authorName: string
	authorTitle: string
	companyName?: string
	signatureSvg?: string
	authorImage?: string | { url?: string | null; alt?: string | null } | null
	blockType: 'founderNote'
}

const {
	heading = 'We care about more than pretty pixels',
	content,
	authorName = 'John Doe',
	authorTitle = 'Founder & CEO',
	companyName,
	signatureSvg,
	authorImage,
} = Astro.props

const authorImageUrl = typeof authorImage === 'string'
	? authorImage
	: authorImage?.url || null

const renderLexicalContent = (lexicalContent: any) => {
	if (!lexicalContent || !lexicalContent.root || !lexicalContent.root.children) {
		return ''
	}

	return lexicalContent.root.children
		.map((node: any) => {
			if (node.type === 'paragraph' && node.children) {
				const text = node.children
					.map((child: any) => {
						if (child.format && child.format > 0) {
							let formattedText = child.text || ''
							if (child.format & 1)
								formattedText = `<strong class="font-semibold text-foreground">${formattedText}</strong>`
							if (child.format & 2) formattedText = `<em class="italic">${formattedText}</em>`
							return formattedText
						}
						return child.text || ''
					})
					.join('')
				return `<p class="mb-5 last:mb-0">${text}</p>`
			}
			return ''
		})
		.join('')
}
---

<section class="relative w-full py-16 md:py-24 overflow-hidden bg-background">
	<GridDesign />
	<div class="container relative z-10 mx-auto px-4 md:px-6">
		<div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-0 items-start">
			<!-- Left column: Heading + Author -->
			<div class="md:col-span-4 md:col-start-2 flex flex-col gap-12 md:pr-10">
				<h2 class="text-[clamp(2rem,5vw,2.75rem)] font-normal leading-[1.15] tracking-tight text-foreground">
					{heading}
				</h2>

				<div class="flex items-center gap-3.5">
					{authorImageUrl && (
						<div class="w-14 h-14 rounded-xl overflow-hidden shrink-0 shadow-sm">
							<img
								src={authorImageUrl}
								alt={authorName}
								width="56"
								height="56"
								loading="lazy"
								class="w-full h-full object-cover block"
							/>
						</div>
					)}
					<div>
						<p class="text-[15px] font-semibold text-foreground m-0">{authorName}</p>
						<p class="text-[13px] text-muted-foreground m-0 mt-0.5">
							{authorTitle}{companyName ? `, ${companyName}` : ''}
						</p>
					</div>
				</div>
			</div>

			<!-- Right column: Note card -->
			<div class="md:col-span-6">
				<div class="bg-card px-8 py-10 shadow-sm border border-border">
					<div class="text-[15px] leading-relaxed text-muted-foreground">
						<Fragment set:html={renderLexicalContent(content)} />
					</div>

					{signatureSvg && (
						<div class="mt-8 opacity-50 dark:invert [&>svg]:max-w-[140px] [&>svg]:h-auto">
							<Fragment set:html={signatureSvg} />
						</div>
					)}
				</div>
			</div>
		</div>
	</div>
</section>
