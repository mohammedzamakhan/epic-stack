---
import Section from '../site/Section.astro'

interface Props {
	title?: string
	highlightText?: string
	rippleSettings?: {
		mainCircleSize?: number
		mainCircleOpacity?: number
		numCircles?: number
	}
	blockType: 'buildFor'
}

const {
	title = 'Built by developers,',
	highlightText = 'crafted for founders',
} = Astro.props
---

<Section class="py-20 sm:py-28 lg:py-32">
	<div class="mx-auto max-w-4xl text-center">
		<h2 class="font-display text-balance text-[40px] font-medium tracking-[-0.03em] text-foreground sm:text-[56px] lg:text-[64px]">
			{title}
			<span class="text-brand">{highlightText}</span>
		</h2>
	</div>
</Section>
