---
import BenefitsList from './BenefitsList.astro'

interface Props {
	node: {
		eyebrow?: string
		title?: string
		items?: Array<{ text?: string } | string>
	}
}

const { node = {} as Props['node'] } = Astro.props

const items = (node.items ?? [])
	.map((item) => (typeof item === 'string' ? item : item?.text))
	.filter((item): item is string => Boolean(item?.trim()))
---

<BenefitsList
	eyebrow={node.eyebrow}
	title={node.title}
	items={items}
	blockType="benefitsList"
/>
