---
import Section from '../site/Section.astro'
import SectionHead from '../site/SectionHead.astro'

interface StatItem {
	value: string
	label: string
}

interface Props {
	title?: string
	description?: string
	stats?: StatItem[]
	blockType: 'stats'
}

const {
	title = 'Delivering measurable results',
	description = 'Our platform helps companies ship faster and scale with confidence.',
	stats = [
		{ value: '+85%', label: 'Conversion Rate' },
		{ value: '12K', label: 'Active Users' },
		{ value: '40%', label: 'Revenue Growth' },
	],
} = Astro.props
---

<Section class="py-16 sm:py-20 lg:py-24" aria-labelledby={title ? 'stats-heading' : undefined}>
	{
		(title || description) && (
			<SectionHead eyebrow="Stats" title={title || ''} description={description} />
		)
	}

	<div class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-3">
		{
			stats.map((stat) => (
				<div class="rounded-3xl border border-hairline bg-card px-6 py-8 text-center">
					<div
						class="stat-value font-display text-[40px] font-medium tracking-[-0.03em] text-brand sm:text-[48px]"
						data-value={stat.value}
					>
						{stat.value}
					</div>
					<p class="mt-2 text-[14px] text-muted-foreground">{stat.label}</p>
				</div>
			))
		}
	</div>
</Section>

<script>
	function animateStats() {
		const section = document.querySelector('section:has(.stat-value)')
		if (!section) return

		const statElements = section.querySelectorAll('.stat-value') as NodeListOf<HTMLElement>

		function parseStatValue(raw: string) {
			const match = raw.match(/^([^0-9]*?)([\d.]+)(.*)$/)
			if (!match) return { prefix: raw, number: 0, decimals: 0, suffix: '' }
			const prefix = match[1]
			const numStr = match[2]
			const suffix = match[3]
			const number = parseFloat(numStr)
			const decimalPart = numStr.split('.')[1]
			const decimals = decimalPart ? decimalPart.length : 0
			return { prefix, number, decimals, suffix }
		}

		function easeOutCubic(t: number) {
			return 1 - Math.pow(1 - t, 3)
		}

		function animateValue(el: HTMLElement) {
			const raw = el.dataset.value || el.textContent || ''
			const { prefix, number, decimals, suffix } = parseStatValue(raw)
			if (number === 0) return

			const duration = 2000
			const startTime = performance.now()

			function update(currentTime: number) {
				const elapsed = currentTime - startTime
				const progress = Math.min(elapsed / duration, 1)
				const currentValue = easeOutCubic(progress) * number
				el.textContent = `${prefix}${currentValue.toFixed(decimals)}${suffix}`
				if (progress < 1) requestAnimationFrame(update)
				else el.textContent = raw
			}

			el.textContent = `${prefix}${(0).toFixed(decimals)}${suffix}`
			requestAnimationFrame(update)
		}

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						statElements.forEach((el) => animateValue(el))
						observer.disconnect()
					}
				})
			},
			{ threshold: 0.3 },
		)

		observer.observe(section)
	}

	animateStats()
	document.addEventListener('astro:page-load', animateStats)
</script>
