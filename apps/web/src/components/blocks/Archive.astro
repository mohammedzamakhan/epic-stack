---
import Section from '../site/Section.astro'
import SectionHead from '../site/SectionHead.astro'

interface Props {
	populateBy?: string
	relationTo?: string
	blockType: 'archive'
}

const { populateBy, relationTo } = Astro.props
---

<Section class="py-16 sm:py-20">
	<SectionHead
		eyebrow="Archive"
		title="Content archive"
		description="Browse related content from across the site."
	/>
	<div class="mt-8 rounded-3xl border border-hairline bg-muted px-6 py-5 text-[14px] text-muted-foreground">
		{populateBy && <p>Populate by: {populateBy}</p>}
		{relationTo && <p>Relation to: {relationTo}</p>}
		{!populateBy && !relationTo && <p>Archive content will appear here when configured in the CMS.</p>}
	</div>
</Section>
