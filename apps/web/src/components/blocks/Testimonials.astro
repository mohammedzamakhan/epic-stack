---
import { brand } from '@repo/config/brand'
import GridDesign from '../GridDesign.astro'
import Badge from '../ui/Badge.astro'

interface Testimonial {
	name: string
	role: string
	image: string
	company?: string
	quote: string
}

interface CMSTestimonial {
	quote: string
	authorName: string
	authorTitle: string
	authorCompany?: string
	authorImage: string | { url?: string | null; alt?: string | null } | null
}

interface Props {
	title?: string
	subtitle?: string
	testimonials?: CMSTestimonial[]
	blockType: 'testimonials'
}

const {
	title = 'What our customers say',
	subtitle = 'about collaborating with us',
	testimonials: rawTestimonials = [
		{
			quote:
				'I was going to build my own authentication system using blockchain, AI, and quantum computing... then I discovered this and saved 3 years of my life.',
			name: 'Captain Deploy',
			role: 'Chief Meme Officer',
			company: 'Deploy or Die Inc.',
			image: 'https://i.pravatar.cc/150?img=68',
		},
		{
			quote:
				'The integrations are incredible. We connected all our tools in minutes instead of spending weeks building custom solutions.',
			name: 'Bugs Bunyan',
			role: 'Lead Developer',
			company: 'Log Overflow',
			image: 'https://i.pravatar.cc/150?img=11',
		},
		{
			quote: `${brand.name} saved me 127.3 hours of boilerplate setup...`,
			name: 'Ctrl Alt Delete',
			role: 'Reformed Code Artist',
			company: 'Infinite Loop Labs',
			image: 'https://i.pravatar.cc/150?img=23',
		},
		{
			quote:
				"The TypeScript setup is so good, it caught errors I hadn't even made yet...",
			name: 'Null Pointer',
			role: 'Duck Whisperer',
			company: 'Try-Catch Paradise',
			image: 'https://i.pravatar.cc/150?img=15',
		},
		{
			quote:
				'Implementing auth used to take longer than explaining why I still use PHP. Not anymore! Well, at least the auth part.',
			name: 'Legacy Larry',
			role: 'Time Optimization Specialist',
			company: '404 Found',
			image: 'https://i.pravatar.cc/150?img=33',
		},
		{
			quote:
				'Our sprint planning used to be "Fix auth bugs" every week. Now we actually build features! What a concept!',
			name: 'Agile Gandalf',
			role: 'Sprint Survivor',
			company: 'You Shall Not Crash',
			image: 'https://i.pravatar.cc/150?img=3',
		},
		{
			quote:
				'I was about to switch careers and become a goat farmer. Then I found this solution. The goats are disappointed.',
			name: 'Git Shepherd',
			role: 'Almost Goat Farmer',
			company: 'Stack Overflow Farms',
			image: 'https://i.pravatar.cc/150?img=42',
		},
		{
			quote:
				'Finally, something that makes auth less painful than explaining blockchain to my grandma.',
			name: 'Hash',
			role: 'Professional Problem Avoider',
			company: 'Stripe',
			image: 'https://i.pravatar.cc/150?img=8',
		},
	],
} = Astro.props

// Transform CMS testimonials to consistent flat structure
const testimonials: Testimonial[] = rawTestimonials.map((testimonial) => {
	if ('authorName' in testimonial) {
		const cms = testimonial as CMSTestimonial
		const imageUrl =
			typeof cms.authorImage === 'string'
				? cms.authorImage
				: (cms.authorImage?.url || 'https://i.pravatar.cc/150?img=1')
		return {
			quote: cms.quote,
			name: cms.authorName,
			role: cms.authorTitle,
			company: cms.authorCompany,
			image: imageUrl,
		}
	}
	return testimonial as Testimonial
})
---

<section class="relative w-full bg-gradient-to-br pt-12" aria-labelledby="testimonials-heading">
	<GridDesign />
	<div class="container mx-auto relative px-4 md:px-6">
		<div class="mb-8 flex flex-col items-center space-y-4">
			<Badge variant="outline" size="sm"> // WHAT PEOPLE ARE SAYING </Badge>
			<h2
				id="testimonials-heading"
				class="max-w-4xl text-center text-3xl tracking-tight sm:text-5xl md:text-6xl font-title"
			>
				{title}
				<br />
				{subtitle}
			</h2>
		</div>
	</div>
	<div class="mt-12 w-full border-y border-dashed">
		<div class="container mx-auto relative px-4 md:px-6">
			<div class="relative border-muted bg-background">
				<ul
					class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border-foreground/10 border-dashed border-l list-none"
					role="list"
					aria-label="Customer testimonials"
				>
					{
						testimonials.map((testimonial) => (
							<li class="border-foreground/10 transition-colors border-b border-r border-dashed bg-background hover:bg-muted/50">
								<article class="p-6 flex h-full flex-col justify-between">
									<blockquote class="mb-4 text-lg font-title">
										"{testimonial.quote}"
									</blockquote>
									<footer class="flex items-center gap-3">
										<div class="relative h-12 w-12 shrink-0 overflow-hidden rounded-full">
											<img
												src={testimonial.image}
												alt={testimonial.name}
												class="object-cover w-full h-full"
												width="48"
												height="48"
											/>
										</div>
										<div>
											<cite class="font-semibold not-italic">
												{testimonial.name}
											</cite>
											<div class="text-sm text-muted-foreground">
												{testimonial.role}
												{testimonial.company && `, ${testimonial.company}`}
											</div>
										</div>
									</footer>
								</article>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>
</section>
