---
import FeatureList from './FeatureList.astro'

interface Props {
	node: {
		title?: string
		subtitle?: string
		features?: Array<{
			title: string
			description: string
			imageUrl?: string
			testimonialText?: string
			companyName?: string
		}>
	}
}

const { node = {} as any } = Astro.props
const { title, subtitle, features } = node

const mappedFeatures = features?.map((f: any) => ({
	title: f.title || '',
	description: f.description || '',
	image: f.imageUrl || f.image ? { url: f.imageUrl || f.image, alt: f.title } : undefined,
	backgroundImage: f.backgroundImageUrl || f.backgroundImage ? { url: f.backgroundImageUrl || f.backgroundImage, alt: f.title } : undefined,
	testimonial: f.testimonialText ? {
		text: f.testimonialText,
		companyName: f.companyName,
	} : undefined,
}))
---

<FeatureList
	title={title}
	subtitle={subtitle}
	features={mappedFeatures as any}
	blockType="featureList"
/>
