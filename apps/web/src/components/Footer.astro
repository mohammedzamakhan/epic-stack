---
import { brand, getCopyright } from '@repo/config/brand'
import GridDesign from './GridDesign.astro'
import Button from './ui/Button.astro'
import { getFooter } from '../lib/emdash'

const currentLocale = Astro.currentLocale ?? 'en'
const footerData = (await getFooter(currentLocale)) as any
const columns: any[] = Array.isArray(footerData?.columns) ? footerData.columns : []
const copyrightText = footerData?.copyrightText || getCopyright()
const tagline = footerData?.tagline || '// Built with ❤️ for developers'

// Helper to check if we have dynamic columns
const hasDynamicColumns = columns.length > 0

// Current URL for subdomain logic (if needed for links)
const currentUrl = Astro.url
const protocol = currentUrl.protocol
const hostname = currentUrl.hostname
const port = currentUrl.port

const appHostname = hostname.startsWith('app.') ? hostname : `app.${hostname}`
const demoUrl = `${protocol}//${appHostname}${port ? `:${port}` : ''}/signup`
