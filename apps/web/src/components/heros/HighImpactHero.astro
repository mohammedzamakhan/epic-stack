---
import MarkdownText from '../site/MarkdownText.astro'
import Section from '../site/Section.astro'
import Reveal from '../site/Reveal.astro'
import Button from '../ui/Button.astro'

interface Props {
	title?: string
	description?: string
	headline?: string
	subheadline?: string
	badge?: string
	richText?: any
	media?: any
	links?: any[]
}

const { title, description, headline, subheadline, badge, media, links } = Astro.props

const displayTitle = headline || title || ''
const displayDescription = subheadline || description || ''
---

<Section seam={false} class="pt-28 pb-6 sm:pt-32 lg:pt-36">
	<div class="grid grid-cols-1 gap-8 sm:grid-cols-2 sm:items-end">
		<div>
			{
				badge && (
					<p class="mb-5 text-[13px] text-muted-foreground">
						<span class="font-semibold text-foreground">{badge}</span>
					</p>
				)
			}
			<h1 class="font-display text-balance text-[40px] font-medium leading-[1.05] tracking-[-0.03em] text-foreground sm:text-[58px] lg:text-[64px]">
				{displayTitle}
			</h1>
		</div>
		{
			displayDescription && (
				<div class="flex flex-col gap-7">
					<MarkdownText content={displayDescription} class="max-w-md text-pretty text-[17px] leading-relaxed text-muted-foreground" />
				</div>
			)
		}
	</div>

	{
		links && links.length > 0 && (
			<div class="mt-8 flex flex-wrap items-center gap-3">
				{links.map((linkItem: any, i: number) => {
					const href = linkItem?.url || linkItem?.link?.url || '#'
					const label = linkItem?.label || linkItem?.link?.label || linkItem?.text || 'Learn more'
					return (
						<Button
							href={href}
							variant={i === 0 ? 'brand' : 'outline'}
							size="md"
						>
							{label}
						</Button>
					)
				})}
			</div>
		)
	}

	{
		media && typeof media === 'object' && (
			<Reveal class="relative mt-14 overflow-hidden rounded-[28px] border border-hairline bg-card px-6 py-12 sm:px-10 sm:py-16">
				<div
					aria-hidden="true"
					class="pointer-events-none absolute inset-0 opacity-[0.5]"
					style="background-image: radial-gradient(circle at 1px 1px, var(--color-hairline) 1px, transparent 0); background-size: 22px 22px;"
				></div>
				<div class="relative overflow-hidden rounded-2xl border border-hairline">
					<img
						class="w-full object-cover"
						src={media.url}
						alt={media.alt || displayTitle || 'Hero visual'}
						width={media.width || 1200}
						height={media.height || 720}
						loading="eager"
						fetchpriority="high"
						decoding="async"
					/>
				</div>
				<p class="relative mt-10 text-center text-[13px] text-muted-foreground">
					Built for modern teams — from idea to production
				</p>
			</Reveal>
		)
	}
</Section>
