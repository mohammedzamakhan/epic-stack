---
import MarkdownText from '../site/MarkdownText.astro'
import Section from '../site/Section.astro'
import Button from '../ui/Button.astro'

interface Props {
	title?: string
	description?: string
	headline?: string
	subheadline?: string
	richText?: any
	media?: any
	links?: any[]
}

const { title, description, headline, subheadline, media, links } = Astro.props

const displayTitle = headline || title || ''
const displayDescription = subheadline || description || ''
---

<Section seam={false} class="pt-28 pb-8 sm:pt-32">
	<div class="max-w-3xl space-y-6">
		{
			displayTitle && (
				<h1 class="font-display text-balance text-[36px] font-medium tracking-[-0.03em] text-foreground sm:text-[48px]">
					{displayTitle}
				</h1>
			)
		}
		{
			displayDescription && (
				<MarkdownText content={displayDescription} class="max-w-xl text-pretty text-[17px] leading-relaxed text-muted-foreground" />
			)
		}

		{
			links && links.length > 0 && (
				<div class="flex flex-wrap gap-3">
					{links.map((linkItem: any, i: number) => (
						<Button
							href={linkItem?.url || linkItem?.link?.url || '#'}
							variant={i === 0 ? 'brand' : 'outline'}
							size="md"
						>
							{linkItem?.label || linkItem?.link?.label || 'Learn more'}
						</Button>
					))}
				</div>
			)
		}
	</div>

	{
		media && typeof media === 'object' && (
			<div class="mt-12 overflow-hidden rounded-2xl border border-hairline">
				<img
					class="w-full object-cover"
					src={media.url}
					alt={media.alt || displayTitle || 'Hero image'}
					width={media.width || 1200}
					height={media.height || 600}
					loading="eager"
					fetchpriority="high"
					decoding="async"
				/>
			</div>
		)
	}
</Section>
