---
import MarkdownInline from '../site/MarkdownInline.astro'
import MarkdownText from '../site/MarkdownText.astro'
import Section from '../site/Section.astro'

interface Props {
	title?: string
	description?: string
	headline?: string
	subheadline?: string
	richText?: any
}

const { title, description, headline, subheadline } = Astro.props

const displayTitle = headline || title || ''
const displayDescription = subheadline || description || ''
---

<Section seam={false} class="pt-28 pb-8 sm:pt-32">
	<div class="max-w-2xl space-y-4">
		{
			displayTitle && (
				<h1 class="font-display text-balance text-[28px] font-medium tracking-[-0.02em] text-foreground sm:text-[36px]">
					<MarkdownInline content={displayTitle} />
				</h1>
			)
		}
		{
			displayDescription && (
				<MarkdownText content={displayDescription} class="text-pretty text-[16px] leading-relaxed text-muted-foreground" />
			)
		}
	</div>
</Section>
