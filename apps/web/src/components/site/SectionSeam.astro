---
import HairlineBleed from './HairlineBleed.astro'
import Tick from './Tick.astro'

interface Props {
	ticks?: boolean
}

const { ticks = true } = Astro.props
---

<div class="pointer-events-none w-full overflow-visible" aria-hidden="true">
	<HairlineBleed />
	<div
		class="absolute top-0 h-px bg-hairline"
		style="width: calc(50vw - 50%); left: calc(-50vw + 50%);"
	></div>
	<div
		class="absolute top-0 h-px bg-hairline"
		style="width: calc(50vw - 50%); right: calc(-50vw + 50%);"
	></div>
</div>

{
	ticks && (
		<>
			<Tick class="left-0 top-0 -translate-x-1/2" />
			<Tick class="right-0 top-0 translate-x-1/2" />
		</>
	)
}
