---
import { cn } from '../../lib/utils'

interface Props {
	class?: string
}

const { class: className = '' } = Astro.props
---

<span
	aria-hidden="true"
	class={cn(
		'pointer-events-none absolute z-20 flex size-5 -translate-y-1/2 items-center justify-center rounded-full bg-background',
		className,
	)}
>
	<span class="size-0.5 rounded-full bg-foreground"></span>
</span>
