---
import { marked } from 'marked'

interface Props {
	content?: string
	class?: string
}

const { content, class: className = '' } = Astro.props

if (!content) return null

const html = marked.parse(content)
---
<div 
	class:list={[
		'[&>p]:mb-4 last:[&>p]:mb-0',
		'[&_a]:text-foreground [&_a]:underline [&_a]:underline-offset-2 [&_a]:font-medium hover:[&_a]:text-muted-foreground transition-colors',
		'[&_strong]:font-semibold [&_strong]:text-foreground',
		'[&_ul]:list-disc [&_ul]:pl-5 [&_ul]:mb-4 last:[&_ul]:mb-0',
		'[&_ol]:list-decimal [&_ol]:pl-5 [&_ol]:mb-4 last:[&_ol]:mb-0',
		className
	]}
	set:html={html}
/>
