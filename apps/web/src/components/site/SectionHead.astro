---
import Eyebrow from './Eyebrow.astro'
import MarkdownInline from './MarkdownInline.astro'
import MarkdownText from './MarkdownText.astro'

interface Props {
	eyebrow?: string
	title?: string
	description?: string
}

const { eyebrow, title, description } = Astro.props
---

<div class="grid grid-cols-1 gap-x-10 gap-y-6 lg:grid-cols-2">
	<div>
		{eyebrow && <Eyebrow class="mb-4">{eyebrow}</Eyebrow>}
		{title && (
			<h2 class="font-display max-w-xl text-balance text-[32px] font-medium tracking-[-0.02em] sm:text-[40px]">
				<MarkdownInline content={title} />
			</h2>
		)}
		<slot name="action" />
	</div>
	{
		description && (
			<div class="lg:pt-12">
				<MarkdownText
					content={description}
					class="max-w-md text-pretty text-[16px] leading-relaxed text-muted-foreground [&>p]:mb-4 last:[&>p]:mb-0 [&_a]:text-foreground [&_a]:underline [&_a]:font-medium hover:[&_a]:text-muted-foreground [&_strong]:font-semibold [&_strong]:text-foreground"
				/>
			</div>
		)
	}
</div>
