---
import { brand } from '@repo/config/brand'
import ThemeSwitcher from './ThemeSwitcher.astro'
import LanguageSwitcher from './LanguageSwitcher.astro'
import Button from './ui/Button.astro'
import Navigation from './Navigation.astro'

interface Props {
	bannerEnabled?: boolean
}

const { bannerEnabled = false } = Astro.props

const currentUrl = Astro.url
const protocol = currentUrl.protocol
const hostname = currentUrl.hostname
const port = currentUrl.port

const appHostname = hostname.startsWith('app.') ? hostname : `app.${hostname}`
const demoUrl = `${protocol}//${appHostname}${port ? `:${port}` : ''}/signup`
const loginUrl = `${protocol}//${appHostname}${port ? `:${port}` : ''}/login`
---

<header class="fixed inset-x-0 top-0 z-50" data-banner-enabled={bannerEnabled}>
	<div
		id="site-header-bar"
		class="border-b border-transparent transition-colors duration-300"
	>
		<nav
			class="mx-auto flex h-16 max-w-[1312px] items-center justify-between px-5 sm:px-8 lg:px-14"
			aria-label="Main navigation"
		>
			<div class="flex items-center gap-2">
				<a href="/" aria-label={`${brand.name} home`} class="flex items-center gap-2.5 text-foreground">
					<svg
						aria-hidden="true"
						class="size-5 text-brand"
						viewBox="0 0 65 65"
						fill="none"
						xmlns="http://www.w3.org/2000/svg"
					>
						<path
							fill="currentColor"
							d="M39.445 25.555 37 17.163 65 0 47.821 28l-8.376-2.445Zm-13.89 0L28 17.163 0 0l17.179 28 8.376-2.445Zm13.89 13.89L37 47.837 65 65 47.821 37l-8.376 2.445Zm-13.89 0L28 47.837 0 65l17.179-28 8.376 2.445Z"
						/>
					</svg>
					<span id="header-wordmark" class="text-[19px] font-semibold leading-none tracking-[-0.025em]">
						{brand.name}
					</span>
				</a>
			</div>

			<ul
				id="header-center-nav"
				class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-7 lg:flex"
			>
				<Navigation />
			</ul>

			<div class="flex items-center gap-2">
				<ThemeSwitcher />
				<LanguageSwitcher />
				<Button
					id="header-login-btn"
					href={loginUrl}
					target="_blank"
					variant="outline"
					size="sm"
					class="hidden sm:inline-flex"
				>
					Log in
				</Button>
				<Button href={demoUrl} target="_blank" variant="solid" size="sm">
					Get started
				</Button>
				<button
					id="mobile-menu-trigger"
					type="button"
					class="grid size-10 place-items-center rounded-full text-foreground transition-colors hover:bg-muted lg:hidden"
					aria-label="Open menu"
					aria-expanded="false"
					aria-controls="mobile-menu-panel"
				>
					<svg id="mobile-menu-icon-open" class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
					</svg>
					<svg id="mobile-menu-icon-close" class="hidden size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
					</svg>
				</button>
			</div>
		</nav>

		<div
			id="mobile-menu-panel"
			class="max-h-0 overflow-hidden border-t border-hairline bg-background/95 backdrop-blur-xl transition-[max-height] duration-300 lg:hidden"
		>
			<ul class="flex flex-col gap-1 px-5 py-4 sm:px-8">
				<Navigation isMobile={true} />
				<li class="mt-2 flex gap-2 px-3">
					<Button href={loginUrl} target="_blank" variant="outline" size="sm" class="flex-1">
						Log in
					</Button>
					<Button href={demoUrl} target="_blank" variant="solid" size="sm" class="flex-1">
						Get started
					</Button>
				</li>
			</ul>
		</div>
	</div>
</header>

<script>
	let cleanup: (() => void) | null = null

	function initHeader() {
		if (cleanup) {
			cleanup()
			cleanup = null
		}

		const header = document.querySelector('header[data-banner-enabled]') as HTMLElement | null
		const bar = document.getElementById('site-header-bar')
		const centerNav = document.getElementById('header-center-nav')
		const wordmark = document.getElementById('header-wordmark')
		const loginBtn = document.getElementById('header-login-btn')
		const mobileTrigger = document.getElementById('mobile-menu-trigger')
		const mobilePanel = document.getElementById('mobile-menu-panel')
		const iconOpen = document.getElementById('mobile-menu-icon-open')
		const iconClose = document.getElementById('mobile-menu-icon-close')

		if (!header || !bar) return

		const isBannerEnabled = header.dataset.bannerEnabled === 'true'
		const listeners: Array<{ el: EventTarget; type: string; fn: EventListener }> = []

		function addListener(el: EventTarget, type: string, fn: EventListener, options?: AddEventListenerOptions) {
			el.addEventListener(type, fn, options)
			listeners.push({ el, type, fn })
		}

		function setScrolled(scrolled: boolean) {
			bar!.classList.toggle('border-hairline', scrolled)
			bar!.classList.toggle('bg-background/80', scrolled)
			bar!.classList.toggle('backdrop-blur-xl', scrolled)
			bar!.classList.toggle('border-transparent', !scrolled)
			centerNav?.classList.toggle('lg:hidden', scrolled)
			wordmark?.classList.toggle('hidden', scrolled)
			loginBtn?.classList.toggle('sm:hidden', scrolled)
		}

		function handleScroll() {
			const threshold = isBannerEnabled ? 72 : 24
			setScrolled(window.scrollY > threshold)

			if (isBannerEnabled) {
				header!.style.top = window.scrollY > 48 ? '0' : '3rem'
			}
		}

		function closeMobileMenu() {
			mobilePanel?.classList.remove('max-h-[480px]')
			mobilePanel?.classList.add('max-h-0', 'border-t-0')
			mobileTrigger?.setAttribute('aria-expanded', 'false')
			iconOpen?.classList.remove('hidden')
			iconClose?.classList.add('hidden')
		}

		function openMobileMenu() {
			mobilePanel?.classList.remove('max-h-0', 'border-t-0')
			mobilePanel?.classList.add('max-h-[480px]')
			mobileTrigger?.setAttribute('aria-expanded', 'true')
			iconOpen?.classList.add('hidden')
			iconClose?.classList.remove('hidden')
		}

		function toggleMobileMenu() {
			const isOpen = mobileTrigger?.getAttribute('aria-expanded') === 'true'
			if (isOpen) closeMobileMenu()
			else openMobileMenu()
		}

		addListener(window, 'scroll', handleScroll, { passive: true })
		handleScroll()

		if (isBannerEnabled) {
			header.style.top = '3rem'
		}

		if (mobileTrigger) {
			addListener(mobileTrigger, 'click', toggleMobileMenu)
		}

		mobilePanel?.querySelectorAll('a').forEach((link) => {
			addListener(link, 'click', closeMobileMenu)
		})

		cleanup = () => {
			listeners.forEach(({ el, type, fn }) => el.removeEventListener(type, fn))
		}
	}

	initHeader()
	document.addEventListener('astro:page-load', initHeader)
</script>
