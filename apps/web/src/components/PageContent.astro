---
import RenderHero from './RenderHero.astro'
import RenderBlocks from './RenderBlocks.astro'
import MarketingBlocks from './MarketingBlocks.astro'

interface Props {
  title: string
  content?: any
  hero?: any
  layout?: any[]
  meta?: any
}

const { title, content, hero, layout, meta } = Astro.props
---

<article class="min-h-screen">
  <!-- Render Emdash PortableText Marketing Blocks if present -->
  {content && Array.isArray(content) && content.length > 0 ? (
    <MarketingBlocks value={content} />
  ) : (
    <>
      <!-- Render Legacy Hero Section -->
      {hero && <RenderHero {...hero} />}
      
      <!-- Render Legacy Layout Blocks -->
      {layout && layout.length > 0 && (
        <RenderBlocks blocks={layout} />
      )}
      
      <!-- If no layout blocks, show a basic content structure -->
      {(!hero && (!layout || layout.length === 0)) && (
        <section class="py-24">
          <div class="container mx-auto px-4 max-w-4xl">
            <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">{title}</h1>
            <div class="prose prose-lg max-w-none">
              <p>This page has no content blocks configured.</p>
            </div>
          </div>
        </section>
      )}
    </>
  )}
</article>