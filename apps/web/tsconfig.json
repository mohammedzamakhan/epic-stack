{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"types": ["@astrojs/check/types"],
		"baseUrl": ".",
		"paths": {
			"~/*": ["./src/*"],
			"@/*": ["./src/*"]
		}
	},
	"include": [
		"src/**/*",
		"public/**/*",
		"env.d.ts",
		"emdash-env.d.ts",
		"check-type.ts"
	],
	"exclude": ["dist", "node_modules"]
}
