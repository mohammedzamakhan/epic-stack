# Epic Stack - Mobile App (Expo)
# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# NOTE: Expo uses EXPO_PUBLIC_ prefix for client-accessible variables.
# All EXPO_PUBLIC_ variables are bundled into the app and visible to users.
#
# @defaultRequired=infer @defaultSensitive=false
# @generateTypes(lang=ts, path=env.d.ts)
# ----------

# API Configuration — App listens on 3001 (`npm run dev:app`)
# @required @type=url
EXPO_PUBLIC_API_URL=http://localhost:3001

# OAuth Configuration
# Google OAuth client ID for mobile authentication
# @docs(https://console.cloud.google.com/apis/credentials)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# GitHub OAuth client ID for mobile authentication
# @docs(https://github.com/settings/developers)
EXPO_PUBLIC_GITHUB_CLIENT_ID=
