# Epic Stack - Main Application
# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# @currentEnv=$NODE_ENV
# @defaultRequired=infer @defaultSensitive=false
# @generateTypes(lang=ts, path=env.d.ts)
# ----------

# @type=enum(production, development, test) @sensitive=false
NODE_ENV=development

# @sensitive=false

# @required @sensitive=false
DATABASE_PATH="../../packages/database/db/data.db"

# @required @type=url @sensitive=false
DATABASE_URL="file:./db/data.db?connection_limit=1"

# @sensitive=false
CACHE_DATABASE_PATH="./other/cache.db"

# @required @sensitive
SESSION_SECRET="super-duper-s3cret"

# @required @sensitive
HONEYPOT_SECRET="super-duper-s3cret"

# @sensitive
RESEND_API_KEY=re_blAh_blaHBlaHblahBLAhBlAh

# Email delivery provider for App transactional mail (and platform marketing when
# Admin sets the same value). `resend` (default) or `oci`.
# @type=enum(resend, oci) @sensitive=false
EMAIL_PROVIDER=resend

# Oracle Cloud Email Delivery — required when EMAIL_PROVIDER=oci.
# Same shape as tenant-api OCI vars. Transactional + platform marketing use this.
# @sensitive
OCI_TENANCY_OCID=

# @sensitive
OCI_USER_OCID=

# @sensitive=false
OCI_FINGERPRINT=

# PEM private key for the API user. Use \n for newlines in .env files.
# @sensitive
OCI_PRIVATE_KEY=

# OCI region for Email Delivery + Logging, e.g. us-ashburn-1
# @sensitive=false
OCI_REGION=

# Compartment that owns the approved sender
# @sensitive
OCI_EMAIL_COMPARTMENT_ID=

# Approved sender email address configured in OCI Email Delivery
# @sensitive=false
OCI_EMAIL_SENDER_EMAIL=

# @sensitive=false
OCI_EMAIL_SENDER_NAME=Epic Startup

# Approved sender OCID for oci_emaildelivery metrics filters (optional)
# @sensitive
OCI_EMAIL_SENDER_OCID=

# OCI Logging log OCID for open/click events (required for marketing metrics on OCI)
# @sensitive
OCI_EMAIL_LOG_OCID=

# Signing secret from Resend Dashboard → Webhooks (email.opened, email.clicked).
# Only used when EMAIL_PROVIDER=resend. Webhook URL: {BASE_URL}/api/resend/webhook
# @sensitive
RESEND_WEBHOOK_SECRET=whsec_***

# @sensitive=false
SENTRY_DSN=your-dsn

# Public origin of this app (`https://app.{apex}`). Cookie Domain is inferred
# as `.{apex}` so app. and admin. share the session. Leave as localhost in dev.
# @required @type=url @sensitive=false
BASE_URL=http://localhost:3001

# Extra apex domains the website editor may iframe (tenant Sites).
# Comma-separated. Also derived at runtime from the App Host header and BASE_URL.
# @sensitive=false
PUBLIC_SITE_HOST_SUFFIXES=

# @required @sensitive @type=string(startsWith="sk_")
STRIPE_SECRET_KEY=sk_test_***

# Publishable key for the same Stripe account (embedded tenant shop checkout).
# @required @sensitive=false @type=string(startsWith="pk_")
STRIPE_PUBLISHABLE_KEY=pk_test_***

# @required @sensitive @type=string(startsWith="whsec_")
STRIPE_WEBHOOK_SECRET=whsec_***

# Polar organization access token for tenant shop checkout (Merchant of Record).
# Optional. Polar shops stay disabled until this is set.
# @sensitive
POLAR_ACCESS_TOKEN=

# Polar organization ID. Required when POLAR_ACCESS_TOKEN is a personal token
# rather than an organization access token.
# @sensitive=false
POLAR_ORGANIZATION_ID=

# Polar API environment for shop checkout. Defaults to sandbox.
# @type=enum(sandbox, production) @sensitive=false
POLAR_SERVER=sandbox

# Polar webhook secret from the Polar dashboard (order.paid, checkout.updated).
# @sensitive
POLAR_WEBHOOK_SECRET=

# Checkout.com secret API key (sk_sbox_ / sk_).
# @sensitive
CHECKOUT_SECRET_KEY=

# Checkout.com public key (pk_sbox_ / pk_).
# @sensitive
CHECKOUT_PUBLIC_KEY=

# Account-specific API subdomain prefix from Dashboard → Developers.
# @sensitive=false
CHECKOUT_SUBDOMAIN=

# Processing channel ID for tenant shop payments.
# @sensitive=false
CHECKOUT_PROCESSING_CHANNEL_ID=

# @type=enum(sandbox, production) @sensitive=false
CHECKOUT_ENVIRONMENT=sandbox

# Checkout.com webhook signature key (payment_approved, payment_captured).
# @sensitive
CHECKOUT_WEBHOOK_SECRET=

# @type=url @sensitive=false
STRIPE_PORTAL_URL=https://billing.stripe.com/p/login/test_***

# @type=number @sensitive=false
TRIAL_DAYS=14

# @type=enum(stripe, manual) @sensitive=false
CREDIT_CARD_REQUIRED_FOR_TRIAL=manual

# @type=enum(CLOSED_BETA, PUBLIC_BETA, LAUNCHED) @sensitive=false
LAUNCH_STATUS=LAUNCHED

# @required @sensitive
INTERNAL_COMMAND_TOKEN=dev-internal-command-token-do-not-use-in-prod

# Signs short-lived operator JWTs (audience: "tenant-api-operator") that the
# app UI uses to call the regional tenant-api directly from the browser.
# MUST differ from INTERNAL_COMMAND_TOKEN.
# @required @sensitive
TENANT_OPERATOR_TOKEN=dev-operator-token-do-not-use-in-prod-32b

# Cloudflare jobs-cron Worker URL (storage migration workflow + cron triggers)
# @type=url @sensitive=false
JOBS_CRON_WORKER_URL=http://localhost:8787

# GitHub OAuth (Authentication)
# The mocks rely on these being prefixed with "MOCK_"
# @sensitive=false
GITHUB_CLIENT_ID=MOCK_GITHUB_CLIENT_ID

# @sensitive
GITHUB_CLIENT_SECRET=MOCK_GITHUB_CLIENT_SECRET

# @sensitive
GITHUB_TOKEN=MOCK_GITHUB_TOKEN

# @type=url @sensitive=false
GITHUB_REDIRECT_URI=https://example.com/auth/github/callback

# Google OAuth (Authentication). Unset disables the Google login button.
# @sensitive=false
GOOGLE_CLIENT_ID=MOCK_GOOGLE_CLIENT_ID

# @sensitive
GOOGLE_CLIENT_SECRET=MOCK_GOOGLE_CLIENT_SECRET

# @type=url @sensitive=false
GOOGLE_REDIRECT_URI=https://example.com/auth/google/callback

# @type=boolean @sensitive=false
ALLOW_INDEXING=true

# Tigris Object Storage (S3-compatible) Configuration
# Access key ID is an identifier (also appears in SigV4 presigned URLs); not secret.
# @required @sensitive=false
AWS_ACCESS_KEY_ID=mock-access-key

# @required @sensitive
AWS_SECRET_ACCESS_KEY=mock-secret-key

# @required @sensitive=false
AWS_REGION=auto

# @required @type=url @sensitive=false
AWS_ENDPOINT_URL_S3=https://<account-id>.r2.cloudflarestorage.com

# @required @sensitive=false
BUCKET_NAME=mock-bucket

# ---------- Integrations (via @repo/integrations package) ----------

# @sensitive
INTEGRATION_ENCRYPTION_KEY=

# @sensitive
INTEGRATIONS_OAUTH_STATE_SECRET=

# Jira Integration OAuth Configuration
# @docs(https://developer.atlassian.com/cloud/jira/platform/rest/api-group-projects/)
# @sensitive=false
JIRA_CLIENT_ID=

# @sensitive
JIRA_CLIENT_SECRET=

# Slack Integration OAuth Configuration
# @docs(https://api.slack.com/authentication/oauth-v2)
# @sensitive=false
SLACK_CLIENT_ID=

# @sensitive
SLACK_CLIENT_SECRET=

# Linear Integration OAuth Configuration
# @docs(https://linear.app/settings/api)
# @sensitive=false
LINEAR_CLIENT_ID=

# @sensitive
LINEAR_CLIENT_SECRET=

# GitLab Integration OAuth Configuration
# @docs(https://gitlab.com/-/profile/applications)
# @sensitive=false
GITLAB_CLIENT_ID=

# @sensitive
GITLAB_CLIENT_SECRET=

# ClickUp Integration OAuth Configuration
# @docs(https://app.clickup.com/apps)
# @sensitive=false
CLICKUP_CLIENT_ID=

# @sensitive
CLICKUP_CLIENT_SECRET=

# Notion Integration OAuth Configuration
# @docs(https://www.notion.so/my-integrations)
# @sensitive=false
NOTION_CLIENT_ID=

# @sensitive
NOTION_CLIENT_SECRET=

# Asana Integration OAuth Configuration
# @docs(https://app.asana.com/0/developer-console)
# @sensitive=false
ASANA_CLIENT_ID=

# @sensitive
ASANA_CLIENT_SECRET=

# Trello Integration OAuth Configuration
# @docs(https://trello.com/app-key)
# @sensitive
TRELLO_API_KEY=

# @sensitive
TRELLO_API_SECRET=

# GitHub Integration OAuth Configuration (separate from auth)
# @docs(https://github.com/settings/applications/new)
# @sensitive=false
GITHUB_INTEGRATION_CLIENT_ID=

# @sensitive
GITHUB_INTEGRATION_CLIENT_SECRET=

# ---------- External Services ----------

# Google AI
# @sensitive
GOOGLE_GENERATIVE_AI_API_KEY=

# Chrome Extension
# @sensitive=false
EXTENSION_ID=

# ---------- Enterprise SSO Configuration ----------

# @type=boolean @sensitive=false
SSO_ENABLED=false

# 64 hex characters / 32 bytes
# @sensitive
SSO_ENCRYPTION_KEY=

# ---------- Discord Integration ----------
# @docs(https://discord.com/developers/applications)

# @type=url @sensitive=false
DISCORD_INVITE_URL=https://discord.gg/your-server

# @sensitive=false
DISCORD_CLIENT_ID=

# @sensitive
DISCORD_CLIENT_SECRET=

# @type=url @sensitive=false
DISCORD_REDIRECT_URI=

# @sensitive=false
DISCORD_GUILD_ID=

# ---------- Monitoring ----------

# BetterStack Uptime Monitoring
# @docs(https://betterstack.com)
# @sensitive
BETTERSTACK_API_KEY=

# @type=url @sensitive=false
BETTERSTACK_URL=

# JWT for API authentication
# @required @sensitive
JWT_SECRET=your-jwt-secret

# ---------- Build-time Variables ----------

# Sentry source map upload
# @sensitive
SENTRY_AUTH_TOKEN=

# @sensitive=false
SENTRY_ORG=

# @sensitive=false
SENTRY_PROJECT=

# @sensitive=false
COMMIT_SHA=

# HMAC for audit log integrity. Required in production (@repo/audit).
# @sensitive
AUDIT_LOG_SECRET_KEY=

# Comma-separated extra keys for rotation (optional).
# @sensitive
AUDIT_LOG_SECRET_KEYS=

# Previous key kept during rotation (optional).
# @sensitive
AUDIT_LOG_OLD_SECRET_KEY=

# ---------- Cloudflare for SaaS (Sites custom domains) ----------
# Optional in local/dev. When unset, custom domains are stored locally only.
# @docs(https://developers.cloudflare.com/cloudflare-for-platforms/cloudflare-for-saas/)

# @sensitive
CLOUDFLARE_API_TOKEN=

# @sensitive=false
CLOUDFLARE_ZONE_ID=

# CNAME target customers point their domain at (e.g. sites.epic-startup.me)
# @sensitive=false
CLOUDFLARE_CUSTOM_HOSTNAME_CNAME_TARGET=sites.epic-startup.me

# Base URL for Cloudflare Media Transformations (/cdn-cgi/media). Must be a
# Cloudflare-proxied hostname with Transformations enabled. Leave empty in dev
# to fall back to direct video source URLs.
# @type=url @sensitive=false
MEDIA_TRANSFORM_BASE_URL=

# Regional tenant-api (US data plane). Used for server-to-server provision,
# deprovision, and App loader fetchTenant. Local default matches
# `npm run dev:tenant-api`. Do not pass this URL to the browser when the App is
# served over HTTPS (mixed content).
# @type=url @sensitive=false
TENANT_API_URL=http://localhost:3007

# KSA tenant-api. Local default matches `npm run dev:tenant-api:ksa` (port 3009).
# @type=url @sensitive=false
TENANT_API_URL_KSA=http://localhost:3009

# Verifies tenant-site customer access tokens on US shop checkout endpoints.
# MUST match the US tenant-api `JWT_SECRET` (not App operator `JWT_SECRET`).
# @required @sensitive
TENANT_CUSTOMER_JWT_SECRET=dev-jwt-secret-do-not-use-in-prod-32b

# Browser-facing tenant-api origins for operator pages (customers, marketing,
# reports). Must be HTTPS in local `npm run dev` so the App page can call them
# without mixed content.
# @type=url @sensitive=false
PUBLIC_TENANT_API_URL=https://api.epic-startup.me:2999

# @type=url @sensitive=false
PUBLIC_TENANT_API_URL_KSA=https://api-ksa.epic-startup.me:2999

# Optional. Google Cloud Translation API key for the page-builder Translate buttons.
# @sensitive
GOOGLE_API_KEY=

# @sensitive=false
ROOT_APP=
