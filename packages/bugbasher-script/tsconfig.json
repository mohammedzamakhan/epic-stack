{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"baseUrl": ".",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"strict": true,
		"declaration": true,
		"outDir": "./dist",
		"jsx": "react-jsx",
		"jsxImportSource": "preact",
		"types": ["node", "vite/client"]
	},
	"include": ["src/**/*"],
	"exclude": ["dist", "node_modules"]
}
