{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"outDir": "./dist",
		"declaration": true,
		"declarationMap": true,
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
		"types": ["node"]
	},
	"include": ["index.ts", "src/**/*.ts"],
	"exclude": ["node_modules", "dist", "**/*.test.ts"]
}
